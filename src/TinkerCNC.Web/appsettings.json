{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Only this computer can open the dashboard (it can move the machine and has no login yet).
  "Urls": "http://localhost:5185",
  "TinkerCNC": {
    // Empty = the per-user data folder: %APPDATA%\TinkerCNC on Windows,
    // ~/Library/Application Support/TinkerCNC on macOS. The settings below default to folders inside it.
    "DataDirectory": "",
    // Measured tool-operation times (SQLite); empty = <DataDirectory>/tinkercnc.db.
    "HistoryDatabasePath": "",
    // Programs downloaded from machines; empty = <DataDirectory>/gcode.
    "GCodeCacheDirectory": "",
    // Camera recordings (.mjpeg) and snapshots; empty = <DataDirectory>/recordings.
    "RecordingsDirectory": "",
    // Machines added by hand; empty = <DataDirectory>/machines.json.
    "ManualMachinesPath": "",
    // Installed copies show the dashboard in their own window; "Window": false opens the browser instead, and
    // "Window": true gives builds started from source a window too (e.g. dotnet run -- --TinkerCNC:Window=true).
    // Where the source code of this build can be downloaded (shown under Settings → About). Release builds carry it
    // from the build (-p:SourceUrl=…); a value here overrides that.
    "SourceUrl": "",
    "Updates": {
      // Velopack release feed: a GitHub repository URL or a folder/URL with the files from "vpk pack". Release builds
      // carry it from the build (-p:UpdatesUrl=…); a value here overrides that.
      "Url": ""
    }
  }
}
