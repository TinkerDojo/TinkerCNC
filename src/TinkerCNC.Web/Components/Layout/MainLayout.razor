@inherits LayoutComponentBase

<div class="shell">
    <NavSidebar />
    <SystemNotifier />
    <main class="content">
        @Body
    </main>
</div>

@* Words the scripts show (wwwroot/js/ui-texts.js), in the dashboard's language. *@
<div id="ui-texts" hidden data-view-unavailable="@T["Layout.View3d.Unavailable"]"></div>

<div id="blazor-error-ui" data-nosnippet>
    @T["Layout.Error.Unhandled"]
    <a href="." class="reload">@T["Layout.Error.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
