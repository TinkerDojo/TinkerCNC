@* Where the tool is: top view of the travel area and a side view of the height (2D), or a small 3D view.
   Clicking the top view moves the tool there at clearance height; scrolling zooms it. *@
@using TinkerCNC.Motion
@inherits SessionComponent
@inject JobTrackers Trackers
@inject IJSRuntime JS

<PanelSection Title="Machine view">
    <Tools>
        <div class="seg seg-sm">
            <button class="@(_threeD ? "" : "active")" @onclick="() => _threeD = false">2D</button>
            <button class="@(_threeD ? "active" : "")" @onclick="() => _threeD = true">3D</button>
        </div>
    </Tools>
    <ChildContent>
        @if (Travel is not { } t || Machine is not { } tool)
        {
            <p class="hint muted">@(Connected ? "Waiting for the travel limits and the position…" : "Connect to see where the tool is.")</p>
        }
        else if (!_threeD)
        {
            var w = t.X.Length;
            var h = t.Y.Length;
            var full = MapWindow.Around(w, h, MarkerSize(w, h) * 2);
            var shown = _zoom ?? full;
            var dot = MarkerSize(w, h) * shown.Width / full.Width; // markers keep their size on screen when zoomed
            <div class="mview @(CanMove ? "clickable" : "")" @ref="_map"
                 data-xmin="@V(t.X.Min)" data-ymax="@V(t.Y.Max)" data-width="@V(w)" data-height="@V(h)" data-clickable="@(CanMove ? "true" : "false")"
                 data-full="@full.ViewBox"
                 title="@(CanMove ? "Click to move the tool there (lifted to clearance height first). Scroll to zoom." : "Scroll to zoom.")">
                <svg class="mview-top" viewBox="@shown.ViewBox" preserveAspectRatio="xMidYMid meet">
                    <rect class="mv-travel" x="0" y="0" width="@V(w)" height="@V(h)" />
                    @if (Model is not null)
                    {
                        @* filled in by machine-model.js with a top view of the machine model (the href is set there) *@
                        <image class="mv-topimage" @ref="_topImage" x="0" y="0" width="@V(w)" height="@V(h)" preserveAspectRatio="none" />
                    }
                    @for (var gx = Math.Ceiling(t.X.Min / 50) * 50; gx <= t.X.Max; gx += 50)
                    {
                        <line class="mv-grid" x1="@V(SX(t, gx))" y1="0" x2="@V(SX(t, gx))" y2="@V(h)" />
                    }
                    @for (var gy = Math.Ceiling(t.Y.Min / 50) * 50; gy <= t.Y.Max; gy += 50)
                    {
                        <line class="mv-grid" x1="0" y1="@V(SY(t, gy))" x2="@V(w)" y2="@V(SY(t, gy))" />
                    }

                    @if (JobBounds is { } job)
                    {
                        <rect class="mv-job" x="@V(SX(t, job.MinX))" y="@V(SY(t, job.MaxY))" width="@V(job.MaxX - job.MinX)" height="@V(job.MaxY - job.MinY)"><title>Area of the loaded program</title></rect>
                    }
                    @if (t.BedCornerX is { } bx && t.BedCornerY is { } by)
                    {
                        <path class="mv-bed" d="M @V(SX(t, bx)) @V(SY(t, by) - dot * 3) V @V(SY(t, by)) H @V(SX(t, bx) + dot * 3)"><title>Bed corner (anchor 1)</title></path>
                    }
                    @if (WorkOrigin is { } wo)
                    {
                        <g class="mv-origin"><title>Work origin</title>
                            <line x1="@V(SX(t, wo[0]) - dot * 1.6)" y1="@V(SY(t, wo[1]))" x2="@V(SX(t, wo[0]) + dot * 1.6)" y2="@V(SY(t, wo[1]))" />
                            <line x1="@V(SX(t, wo[0]))" y1="@V(SY(t, wo[1]) - dot * 1.6)" x2="@V(SX(t, wo[0]))" y2="@V(SY(t, wo[1]) + dot * 1.6)" />
                        </g>
                    }
                    @if (Preview.Target is { } target)
                    {
                        <circle class="mv-target" cx="@V(SX(t, target[0]))" cy="@V(SY(t, target[1]))" r="@V(dot)"><title>Go-to target</title></circle>
                    }
                    <circle class="mv-tool" cx="@V(SX(t, tool[0]))" cy="@V(SY(t, tool[1]))" r="@V(dot)"><title>Tool</title></circle>
                </svg>
                <svg class="mview-side" viewBox="0 @V(-dot * 2) 40 @V(t.Z.Length + dot * 4)" preserveAspectRatio="none">
                    <rect class="mv-travel" x="14" y="0" width="12" height="@V(t.Z.Length)" />
                    <line class="mv-clearance" x1="8" x2="32" y1="@V(SZ(t, t.ClearanceZ))" y2="@V(SZ(t, t.ClearanceZ))"><title>Clearance height</title></line>
                    @if (WorkOrigin is { } wz && t.Z.Contains(wz[2]))
                    {
                        <line class="mv-origin-z" x1="6" x2="34" y1="@V(SZ(t, wz[2]))" y2="@V(SZ(t, wz[2]))"><title>Work Z0</title></line>
                    }
                    @if (Preview.Target is { } tz)
                    {
                        <rect class="mv-target" x="10" width="20" y="@V(SZ(t, tz[2]) - 2)" height="4"><title>Go-to target height</title></rect>
                    }
                    <rect class="mv-tool" x="10" width="20" y="@V(SZ(t, tool[2]) - 2)" height="4"><title>Tool height</title></rect>
                </svg>
            </div>
            <div class="mview-legend">
                <span><i class="lg-tool"></i>tool</span>
                <span><i class="lg-origin"></i>work 0</span>
                @if (JobBounds is not null) { <span><i class="lg-job"></i>program</span> }
                @if (Preview.Target is not null) { <span><i class="lg-target"></i>target</span> }
                <span class="mono muted">Z @Css(tool[2])</span>
                <span class="mview-hover mono"></span>
            </div>
            @if (_runner.Error is not null)
            {
                <p class="hint err">@_runner.Error</p>
            }
            else if (Connected && !CanMove)
            {
                <p class="hint muted">Clicking the map moves the tool while the machine is idle.</p>
            }
        }
        <div class="mview-3d" @ref="_stage" hidden="@(!_threeD || Travel is null)"></div>
        @if (Travel is { } travel)
        {
            <p class="hint muted mview-model">@ModelCaption(travel)</p>
        }
    </ChildContent>
</PanelSection>

@code {
    /// <summary>The Go-to target shown as a dashed marker.</summary>
    [Parameter, EditorRequired] public MoveTargetPreview Preview { get; set; } = default!;

    private sealed record ViewState(double[] Min, double[] Max, double[] Tool, double[]? WorkOrigin, double[]? BedCorner, double ClearanceZ, double[]? JobMin, double[]? JobMax, double[]? Target, double? ToolDiameter, ModelState? Model);

    /// <summary>The machine's model and where its origin goes (machine coordinates).</summary>
    private sealed record ModelState(string Name, string Url, double[] Origin, double[]? Nose);

    /// <summary>A part of the top view in drawing units (mm from the travel's left/back corner).</summary>
    public sealed record MapWindow(double X, double Y, double Width, double Height)
    {
        /// <summary>The whole travel with a margin around it.</summary>
        public static MapWindow Around(double width, double height, double margin) =>
            new(-margin, -margin, width + 2 * margin, height + 2 * margin);

        public string ViewBox => $"{V(X)} {V(Y)} {V(Width)} {V(Height)}";
    }

    private readonly ActionRunner _runner = new();
    private bool _threeD;
    private ElementReference _stage;
    private ElementReference _map;
    private string? _mapAttached;
    private MapWindow? _zoom; // null: the whole map
    private IJSObjectReference? _clickModule;
    private IJSObjectReference? _zoomModule;
    private DotNetObjectReference<MachineViewPanel>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _modelModule;
    private IJSObjectReference? _view;
    private bool _creatingView;
    private ElementReference _topImage;
    private string? _topImagePainted; // element id + model + travel the picture was made for
    private GCodeAnalysis? _boundsOf;
    private ToolpathBounds? _workBounds;

    private MachineTravel? Travel => Session.Limits.Travel;
    private bool CanMove => Connected && Travel is not null && MachineSession.IsIdle(Session.Status);
    private MachineModel? Model => Travel is { } t ? MachineModels.For(t) : null;
    private double[]? Machine => Session.Status?.MachinePosition is { Length: >= 3 } m ? m : null;

    /// <summary>Machine position of the work origin (MPos − WPos).</summary>
    private double[]? WorkOrigin => Machine is { } m && Session.Status?.WorkPosition is { Length: >= 3 } w ? [m[0] - w[0], m[1] - w[1], m[2] - w[2]] : null;

    /// <summary>The loaded program's extent in machine coordinates.</summary>
    private ToolpathBounds? JobBounds => WorkBounds is { } b && WorkOrigin is { } o
        ? b.Offset(o)
        : null;

    private ToolpathBounds? WorkBounds
    {
        get
        {
            var analysis = Trackers.Get(Session).Timeline?.Analysis;
            if (!ReferenceEquals(analysis, _boundsOf)) (_boundsOf, _workBounds) = (analysis, analysis?.Toolpath.Bounds());
            return _workBounds;
        }
    }

    protected override void OnInitialized() => MinRenderInterval = TimeSpan.FromMilliseconds(250);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Preview.Changed -= RequestRender;
        Preview.Changed += RequestRender;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await AttachMapInputAsync();
        await PaintTopViewAsync();
        if (!_threeD || Travel is not { } t || Machine is not { } tool) return;
        try
        {
            if (_view is null)
            {
                if (_creatingView) return; // renders arriving meanwhile must not create a second view
                _creatingView = true;
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/machine-view.js");
                _view = await _module.InvokeAsync<IJSObjectReference?>("createMachineView", _stage);
                if (_view is null) return;
            }
            var job = JobBounds;
            await _view.InvokeVoidAsync("update", new ViewState(
                [t.X.Min, t.Y.Min, t.Z.Min], [t.X.Max, t.Y.Max, t.Z.Max], tool, WorkOrigin,
                t.BedCornerX is { } bx && t.BedCornerY is { } by ? [bx, by] : null, t.ClearanceZ,
                job is null ? null : [job.MinX, job.MinY, job.MinZ], job is null ? null : [job.MaxX, job.MaxY, job.MaxZ],
                Preview.Target,
                ToolDiameter,
                Model is { } model ? StateOf(model, t) : null));
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Which model the views use, or why there is none (the machine is recognised by its travel).</summary>
    private string ModelCaption(MachineTravel travel) => Model is { } model
        ? $"{model.Name}: bed model by cinetronix, CC BY 4.0"
        : FormattableString.Invariant($"No machine model for a travel of {travel.X.Length:0.#} × {travel.Y.Length:0.#} mm") +
          (travel.BedCornerX is null ? " (no anchor1 position in the machine's configuration)" : "") +
          $". Known: {string.Join(", ", MachineModels.All.Select(m => FormattableString.Invariant($"{m.Name} {m.Type.TravelX:0} × {m.Type.TravelY:0} mm")))}.";

    private static ModelState StateOf(MachineModel model, MachineTravel travel) =>
        new(model.Name, model.Model.Url, model.Model.OriginIn(travel), model.Model.Nose);

    /// <summary>Diameter of the tool of the operation running, from the program's header.</summary>
    private double? ToolDiameter => Trackers.Get(Session) is { CurrentLine: { } line, Timeline: { } timeline }
        ? timeline.Analysis.SegmentAt(line)?.Tool?.Diameter
        : null;

    /// <summary>A top-down picture of the machine model under the map, made once per image element and travel.</summary>
    private async Task PaintTopViewAsync()
    {
        if (_threeD || _topImage.Id is null || Travel is not { } t || Model is not { } model) return;
        var key = $"{_topImage.Id}|{model.Name}|{t}";
        if (key == _topImagePainted) return;
        _topImagePainted = key;
        try
        {
            _modelModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/machine-model.js");
            await _modelModule.InvokeVoidAsync("paintTopView", _topImage, StateOf(model, t),
                new { MinX = t.X.Min, MaxX = t.X.Max, MinY = t.Y.Min, MaxY = t.Y.Max });
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Console.Error.WriteLine($"Top view could not be drawn: {ex.Message}"); }
    }

    /// <summary>The map element is re-created when the view switches; attach click and zoom handling to each new one.</summary>
    private async Task AttachMapInputAsync()
    {
        if (_threeD || _map.Id is null || _map.Id == _mapAttached) return;
        _mapAttached = _map.Id; // before awaiting: renders arriving meanwhile must not attach again
        try
        {
            _clickModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/map-click.js");
            _self ??= DotNetObjectReference.Create(this);
            await _clickModule.InvokeVoidAsync("attachMapClick", _map, _self);
            _zoomModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/map-zoom.js");
            await _zoomModule.InvokeVoidAsync("attachMapZoom", _map, _self);
        }
        catch (JSDisconnectedException) { }
    }

    /// <summary>The map was zoomed (it already shows <paramref name="window"/>); null when zoomed out completely.</summary>
    [JSInvokable]
    public Task ZoomMap(MapWindow? window) => InvokeAsync(() =>
    {
        _zoom = window;
        StateHasChanged();
    });

    private static double MarkerSize(double width, double height) => Math.Max(width, height) * 0.018;

    /// <summary>A click on the map: move there in machine coordinates, lifted to the clearance height first.</summary>
    [JSInvokable]
    public Task MoveToAsync(double x, double y) => InvokeAsync(async () =>
    {
        if (!CanMove) return;
        var request = new GoToRequest(x, y, null, CoordinateFrame.Machine, LiftFirst: true);
        if (Travel is { } travel && Session.Status is { } status && GoToPlanner.Plan(request, status, travel) is { IsValid: true } plan)
            Preview.Show(plan.Target);
        await _runner.RunAsync(() => Session.GoToAsync(request));
        StateHasChanged();
    });

    // Machine coordinates → drawing: X to the right, Y up (back of the machine at the top), Z up.
    private static double SX(MachineTravel t, double x) => x - t.X.Min;
    private static double SY(MachineTravel t, double y) => t.Y.Max - y;
    private static double SZ(MachineTravel t, double z) => t.Z.Max - z;

    private static string V(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Css(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    protected override void OnDispose()
    {
        Preview.Changed -= RequestRender;
        _ = DisposeViewAsync();
        base.OnDispose();
    }

    private async Task DisposeViewAsync()
    {
        try
        {
            if (_view is not null) { await _view.InvokeVoidAsync("dispose"); await _view.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
            if (_clickModule is not null) await _clickModule.DisposeAsync();
            if (_zoomModule is not null) await _zoomModule.DisposeAsync();
            if (_modelModule is not null) await _modelModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
