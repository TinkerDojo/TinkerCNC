@* Compressed air: clean the whole bed one to three times (pausing a running program meanwhile), or switch it on and off. *@
@inherits SessionComponent

<PanelSection Title="@T["Machine.Air.Title"]">
    <Tools>
        <span class="chip @(Air.IsOn || Busy ? "chip-ok" : "chip-dim")">@T[StateText]</span>
    </Tools>
    <ChildContent>
        <div class="air-buttons">
            @if (Busy)
            {
                <button class="btn btn-primary" disabled="@(!Connected)" title="@T["Machine.Air.StopTitle"]"
                        @onclick="() => _runner.Run(Cleaning.Stop)">
                    <Icon Name="stop" /> @T["Machine.Air.StopCleaning"]
                </button>
            }
            else
            {
                @for (var passes = 1; passes <= BedCleaning.MaxPasses; passes++)
                {
                    var count = passes;
                    <button class="btn btn-ghost" disabled="@(!CanClean)" title="@CleanTitle(count)"
                            @onclick="() => _runner.Run(() => Cleaning.Start(count))">
                        <Icon Name="wind" /> @T["Machine.Air.CleanBed", count]
                    </button>
                }
                @if (Air.IsOn)
                {
                    <button class="btn btn-primary" disabled="@(!Connected)" @onclick="() => _runner.RunAsync(Air.OffAsync)">
                        <Icon Name="stop" /> @T["Machine.Air.SwitchOff"]
                    </button>
                }
                else
                {
                    <button class="btn btn-ghost" disabled="@(!CanSwitchOn)" title="@T["Machine.Air.SwitchOnTitle"]" @onclick="() => _runner.RunAsync(Air.OnAsync)">
                        <Icon Name="wind" /> @T["Machine.Air.SwitchOn"]
                    </button>
                }
            }
        </div>
        @if (Connected && !Busy && !Air.IsOn && !BedCleaning.CanStartIn(Session.Status))
        {
            <p class="hint warn">@T.Html("Machine.Air.CantCleanInState", Session.Status?.State ?? T["Common.Unknown"])</p>
        }
        else if (Connected && Session.Limits.Travel is null)
        {
            <p class="hint muted">@T["Machine.Air.NeedsLimits", LimitsState]</p>
        }
        @if ((Cleaning.LastError ?? _runner.Error) is { } error)
        {
            <p class="hint err">@T[error]</p>
        }
        <p class="hint muted">
            @T.Html("Machine.Air.CleanHint", JobSuspension.SuspendCommand, JobSuspension.ResumeCommand)
            @if (Air.Output is { } output)
            {
                <span>@T.Html("Machine.Air.OutputHint", output.Description, output.OnCommand, output.OffCommand)</span>
            }
        </p>
    </ChildContent>
</PanelSection>

@code {
    private static readonly IReadOnlyDictionary<BedCleaningPhase, Func<BedCleaning, Text>> PhaseTexts =
        new Dictionary<BedCleaningPhase, Func<BedCleaning, Text>>
        {
            [BedCleaningPhase.None] = _ => Text.Plain(""),
            [BedCleaningPhase.PausingJob] = _ => Texts.Of("Machine.Air.Phase.PausingJob"),
            [BedCleaningPhase.Sweeping] = c => c.Pass == 0
                ? Texts.Of("Machine.Air.Phase.MovingToBed")
                : Texts.Of("Machine.Air.Phase.Cleaning", c.Pass, c.Passes),
            [BedCleaningPhase.Returning] = _ => Texts.Of("Machine.Air.Phase.Returning"),
            [BedCleaningPhase.ResumingJob] = _ => Texts.Of("Machine.Air.Phase.ResumingJob"),
        };

    private readonly ActionRunner _runner = new();

    private AirControl Air => Session.Air;
    private BedCleaning Cleaning => Session.BedCleaning;
    private bool Busy => Cleaning.IsRunning;
    private bool CanClean => Connected && Session.Limits.Travel is not null && BedCleaning.CanStartIn(Session.Status);
    private bool CanSwitchOn => Connected && Air.Output is not null && AirControl.CanSwitchOnIn(Session.Status);
    private Text StateText => Busy ? PhaseTexts[Cleaning.Phase](Cleaning)
        : Air.IsOn ? Texts.Of("Machine.Air.On") : Texts.Of("Machine.Air.Off");

    // why the travel limits are missing, or that they are being read (a host text or ours)
    private object LimitsState => (object?)Session.Limits.Error ?? Texts.Of("Machine.Air.ReadingLimits");

    private string CleanTitle(int passes) => BedCleaning.PausesJobIn(Session.Status)
        ? T["Machine.Air.PauseAndCleanTitle", passes]
        : T["Machine.Air.CleanTitle", passes];
}
