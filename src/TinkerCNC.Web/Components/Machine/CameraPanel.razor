@inherits LiveComponent
@inject CameraService Camera
@inject IJSRuntime JS

<section class="card video-card">
    <div class="card-head">
        <h2><Icon Name="camera" /> @T["Machine.Camera.Title"]</h2>
        <div class="head-tools">
            @if (_feed.Running)
            {
                <span class="chip @(_feed.Connected ? "chip-ok" : "chip-warn")">
                    <span class="dot @(_feed.Connected ? "dot-on" : "dot-wait")"></span>
                    @(_feed.Connected ? $"{_feed.Fps:0.#} fps" : T["Machine.Camera.Connecting"])
                </span>
            }
            <span class="mono small muted">ws://@Host:82/ws_video</span>
        </div>
    </div>

    <div class="video-stage" @ref="_stage">
        @if (_feed.Running)
        {
            <img class="video" src="@($"video/{_feed.SourceId}/stream?n={_nonce}")" alt="@T["Machine.Camera.Title"]" />
            @if (_feed.Frames == 0)
            {
                <div class="video-overlay">
                    <span class="spinner lg"></span>
                    <span>@(_feed.LastError is { } e ? T[e] : T["Machine.Camera.WaitingForFrames"])</span>
                </div>
            }
            @if (_feed.IsRecording)
            {
                <div class="rec-badge"><span class="rec-dot"></span>@(_feed.IsTimelapse ? T["Machine.Camera.Badge.Timelapse"] : T["Machine.Camera.Badge.Recording"]) @Elapsed · @T.Count("Machine.Camera.RecordedFrames", _feed.RecordedFrames)</div>
            }
        }
        else
        {
            <div class="video-placeholder">
                <Icon Name="camera" Size="44" />
                <p>@T["Machine.Camera.IsOff"]</p>
                <button class="btn btn-primary" @onclick="Start"><Icon Name="play" /> @T["Machine.Camera.Start"]</button>
                <p class="muted small">@T.Html("Machine.Camera.StartHint")</p>
            </div>
        }
    </div>

    <div class="video-bar">
        @if (_feed.Running)
        {
            <button class="btn btn-ghost" @onclick="Stop"><Icon Name="stop" /> @T["Common.Stop"]</button>
            @if (_feed.IsRecording)
            {
                <button class="btn btn-rec active" @onclick="StopRecordingAsync"><Icon Name="stop" /> @T["Machine.Camera.StopRecording"]</button>
            }
            else
            {
                <button class="btn btn-rec" @onclick="StartRecording"><Icon Name="record" /> @T["Machine.Camera.Record"]</button>
            }
            <button class="btn btn-ghost" disabled="@(_feed.Frames == 0)" @onclick="Snapshot"><Icon Name="snapshot" /> @T["Machine.Camera.Snapshot"]</button>
            <div class="zoom-controls" title="@T["Machine.Camera.ZoomHint"]">
                <button class="btn btn-icon" title="@T["Machine.Camera.ZoomOut"]" @onclick="() => ZoomAsync(1 / ZoomStep)"><Icon Name="zoom-out" /></button>
                <button class="zoom-level mono" title="@T["Machine.Camera.ZoomReset"]" @onclick="ResetZoomAsync">1.0×</button>
                <button class="btn btn-icon" title="@T["Machine.Camera.ZoomIn"]" @onclick="() => ZoomAsync(ZoomStep)"><Icon Name="zoom-in" /></button>
            </div>
            <button class="btn btn-icon" title="@T["Machine.Camera.Fullscreen"]" @onclick="Fullscreen"><Icon Name="fullscreen" /></button>
        }
        <div class="spacer"></div>
        <span class="muted small">@(_feed.Frames > 0 ? T.Count("Machine.Camera.FramesSeen", _feed.Frames, TimeFormat.Ago(_feed.LastFrameUtc)) : "")</span>
    </div>

    @if (_saved.Count > 0)
    {
        <ul class="files">
            @foreach (var f in _saved.AsEnumerable().Reverse().Take(5))
            {
                <li>
                    <Icon Name="@(RecordingStore.IsVideo(f) ? "film" : "snapshot")" />
                    <a href="@($"recordings/{Uri.EscapeDataString(Path.GetFileName(f))}")" target="_blank">@Path.GetFileName(f)</a>
                    <span class="muted small mono" title="@f">@Path.GetDirectoryName(f)</span>
                </li>
            }
        </ul>
    }
    @if (_feed.LastError is { } err && _feed.Frames > 0)
    {
        <p class="hint warn">@T[err]</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Host { get; set; } = "";
    [Parameter] public string? Label { get; set; }

    private const double ZoomStep = 1.5;

    private CameraFeed _feed = default!;
    private ElementReference _stage;
    private IJSObjectReference? _zoomModule;
    private IJSObjectReference? _zoom;
    private int _nonce;
    private readonly List<string> _saved = new();

    private string Elapsed => _feed.RecordingStartedUtc is { } t ? (DateTime.UtcNow - t).ToString(@"mm\:ss") : "";

    protected override void OnInitialized()
    {
        Camera.Changed += OnFeedChanged;
        StartTicker(TimeSpan.FromSeconds(1));
    }

    protected override void OnParametersSet() => _feed = Camera.Get(Host);

    private void OnFeedChanged(CameraFeed feed)
    {
        if (ReferenceEquals(feed, _feed)) RequestRender();
    }

    /// <summary>Zoom and pan of the live image (wwwroot/js/zoom-view.js); a view-only transform.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _zoomModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/zoom-view.js");
            _zoom = await _zoomModule.InvokeAsync<IJSObjectReference>("createZoomView", _stage, ".zoom-level");
        }
        catch (JSDisconnectedException) { }
    }

    private Task ZoomAsync(double factor) => InvokeZoomAsync("zoomBy", factor);

    private Task ResetZoomAsync() => InvokeZoomAsync("reset");

    private async Task InvokeZoomAsync(string method, params object?[] args)
    {
        if (_zoom is null) return;
        try { await _zoom.InvokeVoidAsync(method, args); }
        catch (JSDisconnectedException) { }
    }

    private async Task Start()
    {
        _nonce++;
        Camera.Start(Host);
        await ResetZoomAsync();
    }

    private async Task Stop()
    {
        await StopRecordingAsync();
        Camera.Stop(Host);
    }

    private void StartRecording() => Camera.StartRecording(Host, Label);

    private async Task StopRecordingAsync()
    {
        if (await Camera.StopRecordingAsync(Host) is { } path) _saved.Add(path);
    }

    private void Snapshot()
    {
        if (Camera.SaveSnapshot(Host, Label) is { } path) _saved.Add(path);
    }

    private async Task Fullscreen()
    {
        try { await JS.InvokeVoidAsync("tinkercnc.fullscreen", _stage); } catch { }
    }

    protected override void OnDispose()
    {
        Camera.Changed -= OnFeedChanged;
        _ = DisposeZoomAsync();
    }

    private async Task DisposeZoomAsync()
    {
        try
        {
            await InvokeZoomAsync("dispose");
            if (_zoom is not null) await _zoom.DisposeAsync();
            if (_zoomModule is not null) await _zoomModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
