@page "/Error"
@using System.Diagnostics

<PageTitle>@T["Pages.Error.PageTitle"]</PageTitle>

<h1 class="text-danger">@T["Pages.Error.Title"]</h1>
<h2 class="text-danger">@T["Pages.Error.Message"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@T["Pages.Error.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@T["Pages.Error.DevMode"]</h3>
<p>
    @T.Html("Pages.Error.DevSwitch")
</p>
<p>
    @T.Html("Pages.Error.DevWarning")
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
