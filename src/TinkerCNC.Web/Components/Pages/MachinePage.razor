@page "/machine/{Address}"
@inherits LiveComponent
@inject MachineDirectory Directory
@inject MachineSessionManager Sessions

<PageTitle>@_session.Name · TinkerCNC</PageTitle>

<header class="page-head machine-head">
    <div class="head-left">
        <a class="btn btn-icon" href="/" title="Back to machines"><Icon Name="back" Size="18" /></a>
        <div>
            <h1>@_session.Name</h1>
            <div class="head-meta">
                <span class="mono">@_session.Address</span>
                <SessionStateChip Session="_session" />
                @if (_session.StatusUtc is { } t && _session.State == SessionState.Connected)
                {
                    <span class="muted small">status @TimeFormat.Ago(t)</span>
                }
            </div>
        </div>
    </div>
    <div class="head-actions">
        <StateBadge State="@_session.Status?.State" />
        @if (_session.State is SessionState.Connected)
        {
            <button class="btn btn-ghost" @onclick="_session.DisconnectAsync">Disconnect</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(_session.State == SessionState.Connecting)" @onclick="ConnectAsync">
                <Icon Name="plug" /> Connect
            </button>
        }
    </div>
</header>

@if (_session.LastAlarm is { } alarm && _session.Status?.State?.StartsWith("Alarm", StringComparison.OrdinalIgnoreCase) == true)
{
    <div class="alarm-banner">
        <strong>Alarm</strong>
        <span>@alarm</span>
        <div class="spacer"></div>
        <button class="btn btn-sm btn-light" @onclick="() => Run(_session.UnlockAsync)">Unlock ($X)</button>
        <button class="btn btn-sm btn-light" @onclick="() => Run(_session.ResetAsync)">Reset</button>
    </div>
}
@if (_runner.Error is not null)
{
    <div class="notice notice-err dismissable" @onclick="_runner.Clear">@_runner.Error <Icon Name="x" /></div>
}

<div class="dash">
    <div class="viewers">
        <CameraPanel Host="@_session.Host" Label="@_session.Name" />
        <ToolpathPanel Session="_session" />
    </div>
    <JobCard Session="_session" Focus="_focus" />
    <QueueCard Session="_session" />
</div>

<SideRail>
    <NotificationsPanel Session="_session" />
    <ControlsPanel Session="_session" />
    <ConsolePanel Session="_session" />
    <GCodePanel Session="_session" Focus="_focus" />
</SideRail>

@code {
    [Parameter] public string Address { get; set; } = "";

    private MachineSession _session = default!;
    private readonly ActionRunner _runner = new();
    private readonly GCodeFocus _focus = new();

    protected override void OnParametersSet()
    {
        var address = Uri.UnescapeDataString(Address);
        var entry = Directory.Find(address);
        if (_session is not null) _session.Changed -= RequestRender;
        _session = Sessions.GetOrCreate(address, entry?.Name ?? address);
        _session.Changed += RequestRender;
        StartTicker(TimeSpan.FromSeconds(1));
    }

    private Task ConnectAsync() => Run(() => _session.ConnectAsync());

    private Task Run(Func<Task> action) => _runner.RunAsync(action);

    protected override void OnDispose()
    {
        if (_session is not null) _session.Changed -= RequestRender;
    }
}
