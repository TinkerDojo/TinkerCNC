@page "/setups"
@inherits LiveComponent
@inject SetupLibrary Library

<PageTitle>@T["Setups.Page.PageTitle"]</PageTitle>

<header class="page-head">
    <div>
        <h1>@T["Setups.Page.Title"]</h1>
        <p class="muted">@T["Setups.Page.Intro"]</p>
    </div>
    <div class="head-actions">
        <button class="btn btn-primary @(_adding ? "active" : "")" @onclick="() => _adding = !_adding"><Icon Name="plus" /> @T["Setups.NewSetup"]</button>
    </div>
</header>

@if (_adding)
{
    <section class="card add-card">
        <NewSetupForm OnDone="() => _adding = false" />
    </section>
}

<section class="card">
    <SetupsList />
</section>

<p class="hint muted">@T.Html("Setups.Page.Storage", Library.Directory)</p>

@code {
    private bool _adding;
}
