@page "/setups"
@inherits LiveComponent
@inject SetupLibrary Library

<PageTitle>Setups · TinkerCNC</PageTitle>

<header class="page-head">
    <div>
        <h1>Setups</h1>
        <p class="muted">
            A setup is a named set of start options with the G-code files that run with it, shared by all machines.
            Open a machine's page to run or queue one.
        </p>
    </div>
    <div class="head-actions">
        <button class="btn btn-primary @(_adding ? "active" : "")" @onclick="() => _adding = !_adding"><Icon Name="plus" /> New setup</button>
    </div>
</header>

@if (_adding)
{
    <section class="card add-card">
        <NewSetupForm OnDone="() => _adding = false" />
    </section>
}

<section class="card">
    <SetupsList />
</section>

<p class="hint muted">Each file is kept as a copy in <span class="mono">@Library.Directory</span>; its options are edited on a machine's page.</p>

@code {
    private bool _adding;
}
