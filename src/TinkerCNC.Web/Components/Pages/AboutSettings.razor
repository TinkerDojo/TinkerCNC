@page "/settings/about"
@inherits LiveComponent
@inject AppUpdates Updates
@inject AppPaths Paths
@inject AppInfo Info

<PageTitle>@T["Pages.About.PageTitle"]</PageTitle>

<header class="page-head">
    <div>
        <h1>@T["Pages.About.Title"]</h1>
        <p class="muted">@Info.Copyright</p>
    </div>
</header>

<section class="card settings-card">
    <div class="card-head"><h2><Icon Name="info" /> @T["Pages.About.License"]</h2></div>
    <p class="about-text">
        @T.Html("Pages.About.LicenseText", AppInfo.LicenseName, AppInfo.License)
    </p>
    <dl class="facts">
        <dt>@T["Pages.About.SourceCode"]</dt>
        <dd class="mono">
            @if (Info.SourceUrl is { } source)
            {
                <a href="@source" target="_blank" rel="noopener">@source</a>
            }
            else
            {
                <text>@T["Pages.About.NotConfigured", "TinkerCNC:SourceUrl"]</text>
            }
        </dd>
        <dt>@T["Pages.About.Documents"]</dt>
        <dd class="legal-links">
            @foreach (var (file, title) in AppInfo.LegalFiles)
            {
                <a href="@($"legal/{file}")" target="_blank">@T[title]</a>
            }
        </dd>
    </dl>
</section>

<section class="card settings-card">
    <div class="card-head"><h2><Icon Name="refresh" /> @T["Pages.About.Updates"]</h2></div>
    <dl class="facts">
        <dt>@T["Pages.About.Version"]</dt>
        <dd class="mono">@Updates.CurrentVersion @(Updates.IsInstalled ? "" : T["Pages.About.DevelopmentBuild"])</dd>
        <dt>@T["Pages.About.Feed"]</dt>
        <dd class="mono">@(Updates.Feed ?? T["Pages.About.NotConfigured", "TinkerCNC:Updates:Url"])</dd>
        <dt>@T["Pages.About.DataFolder"]</dt>
        <dd class="mono">@Paths.DataDirectory</dd>
        @if (Updates.CheckedUtc is { } checkedUtc)
        {
            <dt>@T["Pages.About.LastCheck"]</dt>
            <dd>@TimeFormat.Clock(checkedUtc, T.Culture) · @(Updates.AvailableVersion is { } v ? T["Pages.About.Available", v] : T["Pages.About.UpToDate"])</dd>
        }
    </dl>

    <div class="settings-actions">
        <button class="btn btn-ghost" disabled="@(!Updates.CanUpdate || _busy)" @onclick="CheckAsync"><Icon Name="refresh" /> @T["Pages.About.Check"]</button>
        @if (Updates.AvailableVersion is { } available)
        {
            <button class="btn btn-primary" disabled="@_busy" @onclick="InstallAsync"><Icon Name="down" /> @T["Pages.About.Install", available]</button>
        }
        @if (Updates.DownloadPercent is { } percent)
        {
            <span class="muted small">@T["Pages.About.Downloading", percent]</span>
        }
    </div>

    @if (!Updates.CanUpdate)
    {
        <p class="hint muted">
            @(Updates.IsInstalled
                ? T["Pages.About.SetFeed"]
                : T["Pages.About.BuildOnly"])
        </p>
    }
    @if (_runner.Error is not null)
    {
        <p class="hint err">@T[_runner.Error]</p>
    }
</section>

@code {
    private readonly ActionRunner _runner = new();
    private bool _busy;

    protected override void OnInitialized() => Updates.Changed += RequestRender;

    protected override async Task OnInitializedAsync()
    {
        if (Updates.CanUpdate && Updates.CheckedUtc is null) await CheckAsync();
    }

    private Task CheckAsync() => Busy(Updates.CheckAsync);

    private Task InstallAsync() => Busy(Updates.InstallAndRestartAsync);

    private async Task Busy(Func<Task> action)
    {
        _busy = true;
        try { await _runner.RunAsync(action); }
        finally { _busy = false; }
    }

    protected override void OnDispose() => Updates.Changed -= RequestRender;
}
