<span class="chip @Look.Chip" title="@(Session.Error is { } error ? T[error] : null)">
    @if (Look.Spinner)
    {
        <span class="spinner"></span>
    }
    else
    {
        <span class="dot @Look.Dot"></span>
    }
    @T[Look.Label(Session)]
</span>

@code {
    [Parameter, EditorRequired] public MachineSession Session { get; set; } = default!;

    private sealed record Appearance(string Chip, string Dot, bool Spinner, Func<MachineSession, Text> Label);

    private static readonly IReadOnlyDictionary<SessionState, Appearance> Looks = new Dictionary<SessionState, Appearance>
    {
        [SessionState.Connected] = new("chip-accent", "dot-on", false, s => Texts.Of("Shared.Session.ConnectedSince", TimeFormat.Ago(s.ConnectedSinceUtc))),
        [SessionState.Connecting] = new("chip-warn", "", true, _ => Texts.Of("Shared.Session.Connecting")),
        [SessionState.Failed] = new("chip-err", "dot-err", false, s => s.Error ?? Texts.Of("Shared.Session.Failed")),
        [SessionState.Disconnected] = new("chip-dim", "dot-off", false, _ => Texts.Of("Shared.Session.NotConnected")),
    };

    private Appearance Look => Looks[Session.State];
}
