@* Whether the job can start, what starting it will do, and the button that does it. *@
@inherits JobControlComponent

@{
    var (plan, planError) = PlanOrError();
    var why = Control.WhyNotStart;
    var blocked = why is not null || planError is not null;
}
<aside class="start-panel">
    <div class="start-status @(blocked ? "warn" : "ok")">
        <Icon Name="@(blocked ? "alert" : "check")" />
        <span>@(why is not null ? T[why] : planError is not null ? T[planError] : T["Job.Start.Ready"])</span>
    </div>

    @if (Job.Timeline is { } timeline)
    {
        <div class="start-estimate">
            <span class="k">@T["Job.Start.Estimated"]</span>
            <span class="v">@TimeFormat.Duration(timeline.TotalSeconds)</span>
            @if (timeline.Preparation is { } preparation)
            {
                <span class="muted small">@T["Job.Start.InclProbing", TimeFormat.Duration(preparation.Seconds)]</span>
            }
        </div>
    }

    @if (Control.Resuming is { } resuming)
    {
        <div class="start-from">
            <p class="hint warn">@T["Job.Resume.Hint", resuming.Line, resuming.LineCount]</p>
            @if (resuming.Leveled)
            {
                <p class="hint warn">@T["Job.Resume.Leveled"]</p>
            }
            <details class="start-plan" open>
                <summary>@T["Job.Resume.Commands"]</summary>
                <pre>@string.Join('\n', Control.ResumePreamble)</pre>
            </details>
            <button class="btn btn-sm btn-ghost" disabled="@Control.IsBusy" @onclick="() => _runner.Run(() => Control.StartFrom(0))">
                <Icon Name="reset" /> @T["Job.Resume.FromBeginning"]
            </button>
        </div>
    }
    else if (Control.Operations.Count > 1)
    {
        var interrupted = InterruptedLastTime;
        <div class="start-from">
            @if (interrupted is { } at)
            {
                <p class="hint warn">@T["Job.Start.EndedEarly", at.DisplayLabel]</p>
            }
            <label class="inline-field">@T["Job.Start.From"]
                <select class="input" value="@(Control.StartSegment?.Index ?? 0)" disabled="@Control.IsBusy"
                        @onchange="e => _runner.Run(() => Control.StartFrom(int.Parse((string)e.Value!, CultureInfo.InvariantCulture)))">
                    <option value="0">@T["Job.Start.From.Beginning"]</option>
                    @foreach (var op in Control.Operations.Skip(1))
                    {
                        <option value="@op.Index">@(interrupted?.Index == op.Index ? T["Job.Start.From.OperationInterrupted", op.DisplayLabel, op.StartLine] : T["Job.Start.From.Operation", op.DisplayLabel, op.StartLine])</option>
                    }
                </select>
            </label>
            @if (Control.StartSegment is { } segment)
            {
                <p class="hint muted">@T["Job.Start.From.Hint", segment.DisplayLabel]</p>
                @if (Control.RestartDroppedLeveling && !Options.Leveling)
                {
                    <p class="hint warn">@T["Job.Start.From.Leveled"]</p>
                }
            }
        </div>
    }

    <div>
        <div class="start-steps-head">@T["Job.Start.Steps"]</div>
        <ol class="start-steps">
            @foreach (var step in Steps(plan))
            {
                <li>@step</li>
            }
        </ol>
    </div>

    @if (Options.UsesProbe)
    {
        <p class="hint muted">
            @T["Job.Start.ProbeHint"]
        </p>
    }

    @if (Control.Phase == JobControlPhase.Uploading && Control.Upload is { } up)
    {
        <div class="download">
            <span class="muted small">@T["Job.Start.Uploading", up.Packet, up.TotalPackets, up.Bytes.ToString("N0")]</span>
            <div class="bar"><div style="width:@Css(up.Fraction * 100)%"></div></div>
        </div>
    }
    else if (Control.Phase == JobControlPhase.Starting)
    {
        <div class="start-busy"><span class="spinner"></span> @T["Job.Start.Starting"]</div>
    }
    else
    {
        <button class="btn btn-primary btn-lg btn-block" disabled="@blocked" @onclick="() => _runner.RunAsync(Queue.StartJobAsync)">
            <Icon Name="play" Size="18" /> @T["Job.Start.Start"]
        </button>
    }

    @if (Control.LastError is { } lastError)
    {
        <p class="hint err">@T[lastError]</p>
    }
    else if (_runner.Error is { } error)
    {
        <p class="hint err">@T[error]</p>
    }
    @if (Control.Timelapse.LastPath is { } path)
    {
        <p class="hint muted">@T["Job.Start.LastTimelapse"] <a href="@($"recordings/{Uri.EscapeDataString(Path.GetFileName(path))}")" target="_blank">@Path.GetFileName(path)</a></p>
    }

    <details class="start-plan">
        <summary>@T["Job.Start.Commands"]</summary>
        @if (plan is not null)
        {
            <pre>@string.Join('\n', plan.Commands)</pre>
        }
    </details>
</aside>

@code {
    private readonly ActionRunner _runner = new();

    /// <summary>The operation the last run of this file ended in, when it ended early.</summary>
    private ToolSegment? InterruptedLastTime =>
        Job.LastRun is { EndedEarly: true } run && run.FileName == Control.WholeFileName ? run.Interrupted : null;

    private (JobStartPlan? Plan, Text? Error) PlanOrError()
    {
        try { return (Control.Plan(), null); }
        catch (JobStartException ex) { return (null, Text.Of(ex)); }
    }

    /// <summary>What happens when the job starts, in order, in plain words.</summary>
    private IEnumerable<string> Steps(JobStartPlan? plan)
    {
        var program = Control.Program!;
        var source = program.Source;
        if (source.NeedsUpload) yield return T["Job.Start.Step.Upload", source.FileName, source.MachinePath];
        if (Control.Modes.Count > 0) yield return ModesText();
        if (Options.WorkOrigin is WorkOriginChoice.BedCorner or WorkOriginChoice.HeadPosition)
            yield return T["Job.Start.Step.WorkOrigin", T[WorkOrigins.For(Options.WorkOrigin).Describe(Options)]];
        foreach (var step in plan?.Preparation?.Steps ?? []) yield return T[step.Label];
        var tools = program.Analysis.Segments.Select(s => s.ToolNumber).Distinct().Count();
        yield return T["Job.Start.Step.Run", source.FileName,
            T.Count("Job.Start.Step.Operations", program.Analysis.Segments.Count), T.Count("Job.Start.Step.Tools", tools)];
        if (Options.Timelapse)
            yield return T["Job.Start.Step.Timelapse", JobTimelapse.Interval.TotalSeconds.ToString("0.#", CultureInfo.InvariantCulture),
                JobTimelapse.SpeedUp.ToString("0", CultureInfo.InvariantCulture)];
    }

    private string ModesText()
    {
        var on = Control.Modes.Where(Options.IsOn).ToList();
        var off = Control.Modes.Where(m => !Options.IsOn(m)).ToList();
        return on.Count == 0 ? T["Job.Start.Step.ModesAllOff", ModeNames(off)]
            : off.Count == 0 ? T["Job.Start.Step.ModesOn", ModeNames(on)]
            : T["Job.Start.Step.ModesOnAndOff", ModeNames(on), ModeNames(off)];
    }

    private string ModeNames(IEnumerable<JobMode> modes) => string.Join(", ", modes.Select(m => T[m.Name]));

    private static string Css(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
