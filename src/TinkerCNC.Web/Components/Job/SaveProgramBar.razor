@* Saves the chosen program with its options under a name, or the changed options of the loaded saved program. *@
@using TinkerCNC.Programs
@inherits JobControlComponent

<div class="save-bar">
    @if (Control.Saved is { } saved)
    {
        <span class="muted small">Saved program</span>
        <span class="saved-name">@saved.Name</span>
        @if (Control.SavedChanged)
        {
            <span class="tag tag-warn" title="The options differ from the saved ones">changed</span>
        }
    }
    <span class="spacer"></span>
    @if (Control.Saved is not null)
    {
        <button class="btn btn-sm btn-ghost" disabled="@(Control.IsBusy || !Control.SavedChanged)" title="Store the changed options in this saved program"
                @onclick="() => _runner.Run(Control.SaveChanges)">
            <Icon Name="save" /> Save
        </button>
    }
    <button class="btn btn-sm btn-ghost" disabled="@Control.IsBusy" title="Save the program and these options under a name"
            @onclick="OpenForm">
        <Icon Name="save" /> @(Control.Saved is null ? "Save…" : "Save as…")
    </button>
</div>

@if (_form)
{
    <div class="saved-form save-form">
        <label>Name<input class="input" maxlength="@SavedProgramLibrary.MaxNameLength" @bind="_name" @bind:after="() => _taken = null" /></label>
        <label>Notes<textarea class="input" rows="2" placeholder="Stock, material, bit…" @bind="_notes"></textarea></label>
        @if (_taken is not null)
        {
            <p class="hint err">“@_taken” already exists. Replace it? It is moved to the deleted programs and can be restored.</p>
        }
        <div class="saved-actions">
            @if (_taken is null)
            {
                <button class="btn btn-sm btn-primary" disabled="@Control.IsBusy" @onclick="() => Save(replace: false)">Save</button>
            }
            else
            {
                <button class="btn btn-sm btn-danger" disabled="@Control.IsBusy" @onclick="() => Save(replace: true)">Replace</button>
            }
            <button class="btn btn-sm btn-ghost" @onclick="CloseForm">Cancel</button>
        </div>
    </div>
}
@if (_runner.Error is { } error)
{
    <p class="hint err">@error</p>
}

@code {
    private readonly ActionRunner _runner = new();
    private bool _form;
    private string _name = "";
    private string _notes = "";
    private string? _taken;

    private void OpenForm()
    {
        _runner.Clear();
        _taken = null;
        _name = Control.Saved?.Name ?? Path.GetFileNameWithoutExtension(Control.Program?.Source.FileName ?? "");
        _notes = Control.Saved?.Notes ?? "";
        _form = true;
    }

    private void CloseForm()
    {
        _form = false;
        _taken = null;
    }

    /// <summary>Saves; a name that is taken asks first whether to replace that program.</summary>
    private void Save(bool replace) => _runner.Run(() =>
    {
        try
        {
            Control.SaveAs(_name, _notes, replace);
            CloseForm();
        }
        catch (SavedProgramNameTakenException ex)
        {
            _taken = ex.Name;
        }
    });
}
