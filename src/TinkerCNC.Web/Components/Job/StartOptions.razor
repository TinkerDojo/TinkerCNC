@* The start options of the chosen program, one row per setting; locked while the job is being started. *@
@using TinkerCNC.Web.Components.Job.Options
@inherits JobControlComponent

<fieldset class="job-options" disabled="@Control.IsBusy" title="@(Control.IsBusy ? T["Job.Options.Fixed"] : null)">
    <WorkOriginRow Session="Session" />
    <ZProbeRow Session="Session" />
    <LevelingRow Session="Session" />
    <ModesRow Session="Session" />
</fieldset>
