@* The job of the machine, in one card: what runs now (progress, timeline, pause and stop), or the program chosen
   to start next with its setup, or how to choose one. A job started on the machine itself shows up here too. *@
@inherits JobControlComponent

@{ var look = Looks.First(l => l.Applies(this)).Look; }
<section class="card job-card">
    <div class="card-head">
        <h2><Icon Name="film" /> Job</h2>
        <div class="head-tools">
            <span class="chip @look.Chip">@look.Label</span>
            @if (Playing && Queue.Current is not null)
            {
                <span class="chip chip-accent" title="Started by the queue">queue · job @(Queue.JobsDone + 1) of @Queue.JobsTotal</span>
            }
            @if (Playing)
            {
                @if (Job.File is { } file)
                {
                    <span class="mono small" title="@file.Path">@file.FileName</span>
                }
                @if (Control.Timelapse.Recording)
                {
                    <span class="chip chip-err" title="A time-lapse of this job is being recorded from the camera"><span class="rec-dot sm"></span> time-lapse</span>
                }
                <button class="btn btn-sm btn-icon" disabled="@(!Connected)" title="Ask the machine which file it is running and download it again"
                        @onclick="() => _runner.RunAsync(Job.RefreshAsync)">
                    <Icon Name="refresh" />
                </button>
                <JobRunButtons Session="Session" />
            }
            else if (Control.Program is not null)
            {
                <button class="btn btn-sm btn-ghost" disabled="@Control.IsBusy" title="Choose another program" @onclick="() => OpenPicker(PickerTab.Setups)">
                    <Icon Name="folder" /> Change program
                </button>
                <button class="btn btn-sm btn-icon" disabled="@Control.IsBusy" title="Forget the chosen program" @onclick="() => _runner.Run(Control.Clear)">
                    <Icon Name="x" />
                </button>
            }
        </div>
    </div>

    @if (_runner.Error is { } error)
    {
        <div class="notice notice-err dismissable" @onclick="_runner.Clear">@error <Icon Name="x" /></div>
    }

    @if (Playing)
    {
        <JobProgress Session="Session" Focus="Focus" />
    }
    else if (Control.Program is not null)
    {
        <ProgramStrip Session="Session" />
        @if (Job.Timeline is { } timeline)
        {
            <ToolTimeline Timeline="timeline" Schedule="Job.Schedule(DateTime.UtcNow)" SegmentSelected="FocusSegment" />
        }
        <div class="job-setup">
            <StartOptions Session="Session" />
            <StartPanel Session="Session" />
        </div>
    }
    else
    {
        <JobEmptyState Session="Session" OnPick="OpenPicker" />
    }
</section>

@if (_picker is { } tab)
{
    <ProgramPicker Session="Session" Tab="tab" OnClose="ClosePicker" />
}

@code {
    private sealed record Look(string Chip, string Label);

    /// <summary>The state chip: the first rule that applies.</summary>
    private static readonly (Func<JobCard, bool> Applies, Look Look)[] Looks =
    [
        (c => c.Playing && c.Queue.WaitingForGo, new("chip-warn", "Waiting for the go")),
        (c => c.Playing && c.Job.Preparing, new("chip-warn", "Probing")),
        (c => c.Playing && c.Control.CanResume, new("chip-warn", "Paused")),
        (c => c.Playing && JobSuspension.HasState(c.Session.Status, "Hold"), new("chip-warn", "Hold")),
        (c => c.Playing && JobSuspension.HasState(c.Session.Status, "Tool"), new("chip-warn", "Tool change")),
        (c => c.Playing, new("chip-info", "Running")),
        (c => c.Control.Phase == JobControlPhase.Uploading, new("chip-warn", "Uploading…")),
        (c => c.Control.Phase == JobControlPhase.Starting, new("chip-warn", "Starting…")),
        (c => c.Control.Program is not null && c.Control.WhyNotStart is null, new("chip-ok", "Ready to start")),
        (c => c.Control.Program is not null, new("chip-accent", "Setting up")),
        (_ => true, new("chip-dim", "No job")),
    ];

    private readonly ActionRunner _runner = new();
    private PickerTab? _picker;

    /// <summary>Clicking an operation on the timeline shows its code in the G-code panel.</summary>
    [Parameter, EditorRequired] public GCodeFocus Focus { get; set; } = default!;

    private void OpenPicker(PickerTab tab) => _picker = tab;

    private void ClosePicker() => _picker = null;

    private void FocusSegment(ToolSegment segment) => Focus.Show(segment.StartLine);
}
