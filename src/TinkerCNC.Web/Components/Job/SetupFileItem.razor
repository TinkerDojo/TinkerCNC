@* One file of a setup: choosing it to run, and (while managing) replacing, deleting or restoring it. *@
@using TinkerCNC.Programs
@inject SetupLibrary Library

@{ var f = Entry.File; }
<div class="file-row @(CanPick ? "pickable" : "") @(Active ? "active" : "") @(f.IsDeleted ? "deleted" : "")" @onclick="PickAsync">
    <Icon Name="file" Size="14" />
    <span class="file-name mono">@f.OriginalFileName</span>
    @if (Active)
    {
        <span class="tag tag-accent">@T["Setups.File.Loaded"]</span>
    }
    @if (Entry.FileMissing)
    {
        <span class="tag tag-err" title="@Entry.FilePath">@T["Setups.File.Missing"]</span>
    }
    @if (f.IsDeleted)
    {
        <span class="tag">@T["Setups.File.Deleted", SetupItem.Local(f.DeletedUtc!.Value)]</span>
    }
    <span class="muted small file-meta">@SetupItem.Runs(T, f.RunCount, f.LastStartedUtc)</span>
    <span class="spacer"></span>
    <span class="file-actions" @onclick:stopPropagation="true">
        @if (f.IsDeleted)
        {
            <button class="btn btn-sm btn-ghost" disabled="@Locked" title="@T["Setups.File.RestoreHint"]" @onclick="() => _runner.Run(() => Library.RestoreFile(f.Id))">@T["Common.Restore"]</button>
            @if (_confirm.IsAsking(f.Id))
            {
                <button class="btn btn-sm btn-danger btn-danger-solid" @onclick="() => _runner.Run(() => { _confirm.Clear(); Library.DeleteFileForever(f.Id); })">@T["Common.Confirm"]</button>
            }
            else
            {
                <button class="btn btn-sm btn-ghost btn-danger" title="@T["Setups.File.DeleteForeverHint"]" @onclick="() => _confirm.AskAsync(f.Id)"><Icon Name="trash" /> @T["Setups.DeleteForever"]</button>
            }
        }
        else
        {
            @if (OnPick.HasDelegate)
            {
                <button class="btn btn-sm btn-primary" disabled="@(!CanPick)" title="@T["Setups.File.LoadHint"]" @onclick="PickAsync">
                    <Icon Name="check" /> @T["Setups.File.Load"]
                </button>
            }
            @if (Manage)
            {
                <label class="btn btn-sm btn-ghost file-btn @(Busy ? "disabled" : "")" title="@T["Setups.File.ReplaceHint"]">
                    <Icon Name="upload" /> @T["Setups.File.Replace"]
                    <InputFile OnChange="ReplaceAsync" accept="@ProgramFiles.Accept" disabled="@Busy" />
                </label>
                @if (_confirm.IsAsking(f.Id))
                {
                    <button class="btn btn-sm btn-danger btn-danger-solid" @onclick="() => _runner.Run(() => { _confirm.Clear(); Library.DeleteFile(f.Id); })">@T["Common.Confirm"]</button>
                }
                else
                {
                    <button class="btn btn-sm btn-ghost btn-danger" title="@T["Setups.File.DeleteHint"]" @onclick="() => _confirm.AskAsync(f.Id)"><Icon Name="trash" /> @T["Setups.DeleteAsk"]</button>
                }
            }
        }
    </span>
</div>
@if (_runner.Error is { } error)
{
    <p class="hint err pad-x">@T[error]</p>
}

@code {
    private readonly ActionRunner _runner = new();
    private readonly ConfirmClick _confirm = new();

    [Parameter, EditorRequired] public SetupFileEntry Entry { get; set; } = default!;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Busy { get; set; }

    /// <summary>Whether the file's own actions (replace, delete) are shown.</summary>
    [Parameter] public bool Manage { get; set; }

    /// <summary>The setup is deleted: its files can't be changed until it is restored.</summary>
    [Parameter] public bool Locked { get; set; }

    [Parameter] public EventCallback<SetupFile> OnPick { get; set; }

    private bool CanPick => OnPick.HasDelegate && !Busy && !Entry.FileMissing && !Entry.File.IsDeleted && !Locked;

    private Task PickAsync() => CanPick ? OnPick.InvokeAsync(Entry.File) : Task.CompletedTask;

    private Task ReplaceAsync(InputFileChangeEventArgs e) => _runner.RunAsync(async () =>
    {
        var file = await ProgramFiles.ReadAsync(e.File);
        Library.ReplaceFile(Entry.File.Id, file.Name, file.Content);
    });
}
