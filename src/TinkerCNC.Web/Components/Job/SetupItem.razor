@* One setup: its facts and files, and (opened with Manage) its details, adding files and deletion. *@
@using TinkerCNC.Programs
@inject SetupLibrary Library

@{ var s = Entry.Setup; }
<div class="setup-item @(s.IsDeleted ? "deleted" : "") @(Active ? "active" : "")">
    <div class="setup-main">
        <div class="setup-info">
            <div class="setup-title">
                <Icon Name="library" Size="16" />
                <span>@s.Name</span>
                @if (s.IsDeleted)
                {
                    <span class="tag">@T["Setups.Item.Deleted", Local(s.DeletedUtc!.Value)]</span>
                }
            </div>
            @if (s.Notes.Length > 0)
            {
                <div class="setup-notes" title="@s.Notes">@s.Notes</div>
            }
            <div class="setup-meta">
                <span>@T.Count("Setups.Item.FileCount", Entry.Files.Count)</span>
                <span>@Runs(T, s.RunCount, s.LastStartedUtc)</span>
                <span>@T["Setups.Item.Saved", Local(s.UpdatedUtc)]</span>
                @if (StartOptionsText.Summary(s.Options).ToList() is { Count: > 0 } summary)
                {
                    <span title="@T["Setups.StartOptions"]">@string.Join(" · ", summary.Select(part => T[part]))</span>
                }
                else
                {
                    <span title="@T["Setups.StartOptions"]">@T["Setups.Item.DefaultOptions"]</span>
                }
            </div>
        </div>
        <div class="setup-actions">
            @if (s.IsDeleted)
            {
                <button class="btn btn-sm btn-ghost" title="@T["Setups.Item.RestoreHint"]" @onclick="() => RestoreAsync(null)">@T["Common.Restore"]</button>
                @if (_confirm.IsAsking(s.Id))
                {
                    <button class="btn btn-sm btn-danger btn-danger-solid" @onclick="() => _runner.Run(() => { _confirm.Clear(); Library.DeleteForever(s.Id); })">@T["Common.Confirm"]</button>
                }
                else
                {
                    <button class="btn btn-sm btn-ghost btn-danger" title="@T["Setups.Item.DeleteForeverHint"]" @onclick="() => _confirm.AskAsync(s.Id)"><Icon Name="trash" /> @T["Setups.DeleteForever"]</button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-ghost @(_manage ? "active" : "")" title="@T["Setups.Item.ManageHint"]"
                        @onclick="() => _manage = !_manage">
                    <Icon Name="pencil" /> @T["Setups.Item.Manage"]
                </button>
            }
        </div>
    </div>

    <div class="setup-files">
        @if (Entry.Files.Count == 0)
        {
            <p class="muted small pad-x">@(s.IsDeleted ? T["Setups.Item.NoFiles"] : T["Setups.Item.NoFilesHint"])</p>
        }
        @foreach (var file in Entry.Files)
        {
            <SetupFileItem Entry="file" Active="ActiveFileId == file.File.Id" Busy="Busy" Manage="_manage" Locked="s.IsDeleted" OnPick="OnPick" @key="file.File.Id" />
        }
    </div>

    @if (_manage && !s.IsDeleted)
    {
        <div class="setup-manage">
            <div class="manage-section">
                <h4>@T["Setups.Item.Details"]</h4>
                <label class="field">@T["Setups.Form.Name"]<input class="input" maxlength="@SetupLibrary.MaxNameLength" @bind="_name" /></label>
                <label class="field">@T["Setups.Form.Notes"]<textarea class="input" rows="3" placeholder="@T["Setups.Form.NotesPlaceholder"]" @bind="_notes"></textarea></label>
                <div class="form-actions">
                    <button class="btn btn-sm btn-primary" @onclick="() => _runner.Run(() => Library.Edit(s.Id, _name, _notes))">@T["Setups.Item.SaveDetails"]</button>
                    <button class="btn btn-sm btn-ghost" @onclick="() => _manage = false">@T["Common.Close"]</button>
                </div>
            </div>
            <div class="manage-section">
                <h4>@T["Setups.Files"]</h4>
                <div class="form-actions">
                    <label class="btn btn-sm btn-ghost file-btn @(Busy ? "disabled" : "")" title="@T["Setups.Item.AddFilesHint"]">
                        <Icon Name="upload" /> @T["Setups.Item.AddFiles"]
                        <InputFile OnChange="AddFilesAsync" accept="@ProgramFiles.Accept" multiple disabled="@Busy" />
                    </label>
                </div>
                <p class="hint muted">@T["Setups.Item.FilesHint"]</p>
                <h4>@T["Common.Delete"]</h4>
                <div class="form-actions">
                    @if (_confirm.IsAsking(s.Id))
                    {
                        <button class="btn btn-sm btn-danger btn-danger-solid" @onclick="() => _runner.Run(() => { _confirm.Clear(); Library.Delete(s.Id); })">@T["Setups.Item.ConfirmDelete"]</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-ghost btn-danger" @onclick="() => _confirm.AskAsync(s.Id)"><Icon Name="trash" /> @T["Setups.DeleteAsk"]</button>
                    }
                </div>
                <p class="hint muted">@T["Setups.Item.DeleteHint"]</p>
            </div>
        </div>
    }

    @if (_restoreAs)
    {
        <div class="setup-manage single">
            <div class="manage-section">
                <p class="hint err">@T["Setups.Item.NameTaken", s.Name]</p>
                <label class="field">@T["Setups.Form.Name"]<input class="input" maxlength="@SetupLibrary.MaxNameLength" @bind="_name" /></label>
                <div class="form-actions">
                    <button class="btn btn-sm btn-primary" @onclick="() => RestoreAsync(_name)">@T["Common.Restore"]</button>
                    <button class="btn btn-sm btn-ghost" @onclick="() => _restoreAs = false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (_runner.Error is { } error)
    {
        <p class="hint err pad-x">@T[error]</p>
    }
</div>

@code {
    private readonly ActionRunner _runner = new();
    private readonly ConfirmClick _confirm = new();
    private bool _manage;
    private bool _restoreAs;
    private string _name = "";
    private string _notes = "";

    [Parameter, EditorRequired] public SetupEntry Entry { get; set; } = default!;
    [Parameter] public long? ActiveFileId { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SetupFile> OnPick { get; set; }

    private bool Active => ActiveFileId is { } id && Entry.Files.Any(f => f.File.Id == id);

    private bool DetailsChanged => _name != Entry.Setup.Name || _notes != Entry.Setup.Notes;

    /// <summary>The form shows the stored details, also after an edit elsewhere, unless it is being edited.</summary>
    protected override void OnParametersSet()
    {
        if (_manage && DetailsChanged) return;
        (_name, _notes) = (Entry.Setup.Name, Entry.Setup.Notes);
    }

    /// <summary>Restores it; when its name was taken meanwhile, asks for another one.</summary>
    private Task RestoreAsync(string? newName) => _runner.RunAsync(() =>
    {
        try
        {
            Library.Restore(Entry.Setup.Id, newName);
            _restoreAs = false;
        }
        catch (SetupNameTakenException) when (newName is null)
        {
            (_restoreAs, _name) = (true, Entry.Setup.Name);
        }
        return Task.CompletedTask;
    });

    private Task AddFilesAsync(InputFileChangeEventArgs e) => _runner.RunAsync(async () =>
    {
        foreach (var file in await ProgramFiles.ReadAllAsync(e)) Library.AddFile(Entry.Setup.Id, file.Name, file.Content);
    });

    /// <summary>How often a setup or file was started, and when last (<paramref name="T"/>: the texts to use).</summary>
    public static string Runs(Texts T, int count, DateTime? last) =>
        count == 0 ? T["Setups.Runs.Never"]
        : last is { } l ? T.Count("Setups.Runs.StartedLast", count, Local(l))
        : T.Count("Setups.Runs.Started", count);

    public static string Local(DateTime utc) => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
