@* Horizontal timeline: the probing before the program, then one bar per tool operation, width proportional to its measured or estimated time. *@
@using TinkerCNC.History

<div class="timeline">
    <div class="tl-track">
        @if (Timeline.Preparation is { } preparation)
        {
            <div class="tl-seg tl-prep @(Position?.Preparing == true ? "active" : "") @(preparation.IsMeasured ? "measured" : "")"
                 style="left:0; width:@Css(Percent(preparation.Seconds))%"
                 title="@PreparationTooltip(preparation)">
                @if (Labelled(preparation.Seconds))
                {
                    <span class="tl-seg-label">@JobPreparation.Label</span>
                    <span class="tl-seg-time">
                        @if (preparation.IsMeasured) { <Icon Name="stopwatch" Size="11" /> }
                        @TimeFormat.Duration(preparation.Seconds)
                    </span>
                }
            </div>
        }
        @foreach (var item in Timeline.Segments)
        {
            var segment = item.Segment;
            var active = CurrentSegment?.Segment.Index == segment.Index;
            <button class="tl-seg @(active ? "active" : "") @(item.IsMeasured ? "measured" : "")"
                    style="left:@Css(Percent(item.StartSeconds))%; width:@Css(Percent(item.Seconds))%; --tool:@ToolPalette.ColorFor(segment.ToolNumber)"
                    title="@Tooltip(item)"
                    @onclick="() => SegmentSelected.InvokeAsync(segment)">
                @if (Labelled(item.Seconds))
                {
                    <span class="tl-seg-label">@segment.Label</span>
                    <span class="tl-seg-time">
                        @if (item.IsMeasured) { <Icon Name="stopwatch" Size="11" /> }
                        @if (Measuring?.Index == segment.Index) { <span class="rec-dot sm"></span> }
                        @TimeFormat.Duration(item.Seconds)
                    </span>
                }
            </button>
        }
        @if (Position is not null)
        {
            <div class="tl-done" style="width:@Css(DonePercent)%"></div>
            <div class="tl-cursor" style="left:@Css(DonePercent)%"></div>
        }
    </div>
    <div class="tl-axis">
        <span>@(Position is null ? "0" : "")</span>
        @if (Position is { } position)
        {
            <span class="tl-axis-now" style="left:@Css(DonePercent)%; transform:translateX(-@Css(DonePercent)%)">@TimeFormat.Duration(position.DoneSeconds)</span>
        }
        <span>
            @TimeFormat.Duration(Timeline.TotalSeconds)
            @if (Schedule?.FinishUtc is { } finish)
            {
                <b class="tl-finish"> · ends @TimeFormat.Clock(finish)</b>
            }
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public JobTimeline Timeline { get; set; } = default!;
    [Parameter] public TimelinePosition? Position { get; set; }
    [Parameter] public ToolSegment? Measuring { get; set; }
    [Parameter] public ToolChangeSchedule? Schedule { get; set; }
    [Parameter] public EventCallback<ToolSegment> SegmentSelected { get; set; }

    /// <summary>When a tool change happens, for the operation's tooltip.</summary>
    private static readonly IReadOnlyDictionary<ToolChangeTiming, Func<ScheduledToolChange, string>> ChangeTexts =
        new Dictionary<ToolChangeTiming, Func<ScheduledToolChange, string>>
        {
            [ToolChangeTiming.Planned] = c => $"Tool change {TimeFormat.Duration(c.OffsetSeconds)} after the start",
            [ToolChangeTiming.Upcoming] = c => $"Tool change at {TimeFormat.Clock(c.ClockUtc!.Value)} (in {TimeFormat.Duration(c.InSeconds!.Value)})",
            [ToolChangeTiming.Observed] = c => $"Tool changed at {TimeFormat.Clock(c.ClockUtc!.Value)}",
            [ToolChangeTiming.Passed] = _ => "Tool changed",
        };

    /// <summary>Narrower parts have only their tooltip: a squeezed label reads as part of its neighbour.</summary>
    private const double MinLabelPercent = 2.5;

    private bool Labelled(double seconds) => Percent(seconds) >= MinLabelPercent;

    private TimelineSegment? CurrentSegment => Position?.Line is { } line ? Timeline.SegmentAt(line) : null;

    private double DonePercent => Position is { } p ? Percent(p.DoneSeconds) : 0;

    /// <summary>Position on the bar; bars, cursor and "done" shading all use this, so they line up.</summary>
    private double Percent(double seconds) => Timeline.TotalSeconds > 0 ? Math.Clamp(seconds / Timeline.TotalSeconds * 100, 0, 100) : 0;

    private string Tooltip(TimelineSegment item)
    {
        var s = item.Segment;
        var source = item.Measurement is { } m ? Measured(m, item.EstimatedSeconds) : "Estimated (no recorded run yet)";
        var change = Schedule?.Changes.FirstOrDefault(c => c.Operation.Segment.Index == s.Index) is { } c ? $"\n{ChangeTexts[c.Timing](c)}" : "";
        return $"{s.Label}\n{TimeFormat.Duration(item.Seconds)} (starts at {TimeFormat.Duration(item.StartSeconds)}){change}\n{source}\nLines {s.StartLine}–{s.EndLine}";
    }

    private static string PreparationTooltip(TimelinePreparation item)
    {
        var steps = string.Join("\n", item.Preparation.Steps.Select(s => $"· {s.Name}"));
        var source = item.Measurement is { } m
            ? Measured(m, item.Preparation.EstimatedSeconds)
            : "Rough estimate: measured the first time a job with this probing runs";
        return $"{JobPreparation.Label} before the program, {TimeFormat.Duration(item.Seconds)}\n{steps}\n{source}";
    }

    private static string Measured(OperationStatistics m, double estimatedSeconds) =>
        $"Measured: median of {m.Runs} run(s){(m.FromThisMachine ? "" : " on other machines")}, last {m.LastRecordedUtc.ToLocalTime():g}\nEstimate was {TimeFormat.Duration(estimatedSeconds)}";

    private static string Css(double value, string format = "0.###") => value.ToString(format, CultureInfo.InvariantCulture);
}
