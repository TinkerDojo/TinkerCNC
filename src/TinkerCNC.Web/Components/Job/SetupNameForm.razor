@* Name and notes of a setup; a name that is taken asks whether to replace that setup. Extra fields go in between. *@

<div class="save-form">
    <label class="field">@T["Setups.Form.Name"]<input class="input" maxlength="@SetupLibrary.MaxNameLength" @bind="_name" @bind:after="() => _taken = null" /></label>
    <label class="field">@T["Setups.Form.Notes"]<textarea class="input" rows="2" placeholder="@T["Setups.Form.NotesPlaceholder"]" @bind="_notes"></textarea></label>
    @if (ChildContent is not null)
    {
        <div class="save-form-extra">@ChildContent</div>
    }
    <div class="save-form-foot">
        @if (_taken is not null)
        {
            <span class="hint err">@T["Setups.Form.Taken", _taken]</span>
        }
        else if (_error is not null)
        {
            <span class="hint err">@T[_error]</span>
        }
        <span class="spacer"></span>
        @if (_taken is null)
        {
            <button class="btn btn-sm btn-primary" disabled="@Busy" @onclick="() => SaveAsync(replace: false)">@T[SaveLabel]</button>
        }
        else
        {
            <button class="btn btn-sm btn-danger" disabled="@Busy" @onclick="() => SaveAsync(replace: true)">@T["Setups.Form.Replace"]</button>
        }
        <button class="btn btn-sm btn-ghost" @onclick="OnCancel">@T["Common.Cancel"]</button>
    </div>
</div>

@code {
    /// <summary>Saves under the name; throws <see cref="SetupNameTakenException"/> when the name is taken and not replaced.</summary>
    public delegate void Saver(string name, string notes, bool replace);

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Notes { get; set; } = "";
    [Parameter] public Text SaveLabel { get; set; } = Texts.Of("Common.Save");
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public Saver Save { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _name = "";
    private string _notes = "";
    private string? _taken;
    private Text? _error;

    protected override void OnInitialized() => (_name, _notes) = (Name, Notes);

    private async Task SaveAsync(bool replace)
    {
        _error = null;
        try
        {
            Save(_name, _notes, replace);
        }
        catch (SetupNameTakenException ex)
        {
            _taken = ex.Name;
            return;
        }
        catch (Exception ex)
        {
            _error = Text.Of(ex);
            return;
        }
        await OnSaved.InvokeAsync();
    }
}
