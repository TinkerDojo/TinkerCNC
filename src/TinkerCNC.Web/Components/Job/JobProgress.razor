@* The job running now: time left, progress, the tool in use, the next tool change and the timeline. *@
@inherits JobControlComponent

@if (Job.Phase == JobPhase.Downloading && Job.Download is { } dl)
{
    <div class="download">
        <span class="muted small">@T["Job.Progress.Downloading", Job.File?.FileName, dl.Packet, dl.TotalPackets, dl.Bytes.ToString("N0")]</span>
        <div class="bar"><div style="width:@Css(dl.Fraction * 100)%"></div></div>
    </div>
}

@if (Queue.WaitingForGo && Queue.CurrentItem is { } waiting)
{
    <div class="notice notice-warn queue-gate">
        <Icon Name="play" />
        <span>@T.Html("Job.Queue.Gate", waiting.Label)</span>
    </div>
}

@if (Job.Timeline is { } timeline)
{
    var position = Job.Position;
    var schedule = Job.Schedule(DateTime.UtcNow);
    var percent = position is { } f ? timeline.Fraction(f) * 100 : 0;
    <div class="run-hero">
        <div class="stat stat-hero">
            <span class="k">@T["Job.Progress.Remaining"]</span>
            <span class="v">@(position is { } r ? TimeFormat.Duration(r.RemainingSeconds) : "—")</span>
            @if (schedule?.FinishUtc is { } finish)
            {
                <span class="muted small">@T["Job.Ends", TimeFormat.Clock(finish, T.Culture)]</span>
            }
        </div>
        <div class="stat stat-progress">
            <span class="k">@T["Job.Progress.Progress"]</span>
            <span class="v">@percent.ToString("0", CultureInfo.InvariantCulture) %</span>
            <div class="bar"><div style="width:@Css(percent)%"></div></div>
            <span class="muted small">@(T["Job.Progress.DoneOf", position is { } d ? TimeFormat.Duration(d.DoneSeconds) : "—", TimeFormat.Duration(timeline.TotalSeconds)])</span>
        </div>
        <div class="stat">
            <span class="k">@T["Job.Progress.Tool"]</span>
            <span class="v">
                @if (position is { Preparing: true } && timeline.Preparation is not null)
                {
                    <text>@T[JobPreparation.Label]</text>
                }
                else if (position?.Line is { } line && timeline.Analysis.SegmentAt(line) is { } segment)
                {
                    <span class="swatch" style="background:@ToolPalette.ColorFor(segment.ToolNumber)"></span> @T[segment.DisplayLabel]
                }
                else
                {
                    <text>—</text>
                }
            </span>
        </div>
        <div class="stat">
            <span class="k">@T["Job.Progress.NextToolChange"]</span>
            @if (schedule?.Next is { } next)
            {
                var tool = next.Operation.Segment;
                <span class="v" title="@T["Job.Progress.NextToolChange.Title", tool.DisplayLabel, tool.StartLine]">
                    <span class="swatch" style="background:@ToolPalette.ColorFor(tool.ToolNumber)"></span>
                    @TimeFormat.Clock(next.ClockUtc!.Value, T.Culture)
                </span>
                <span class="muted small">@T["Job.Progress.In", TimeFormat.Duration(next.InSeconds!.Value)]</span>
            }
            else
            {
                <span class="v">—</span>
                <span class="muted small">@T["Job.Progress.NoneLeft"]</span>
            }
        </div>
        <div class="stat">
            <span class="k" title="@T["Job.Progress.Feed.Title"]">@T["Job.Progress.Feed"]</span>
            <span class="v">@Job.FeedOverridePercent.ToString("0", CultureInfo.InvariantCulture) %</span>
        </div>
    </div>

    <div class="run-notes">
        @if (Job.Measuring is { } measuring)
        {
            <span class="recording-note"><span class="rec-dot"></span> @T.Html("Job.Progress.Timing", measuring.DisplayLabel, measuring.CuttingStartLine, measuring.EndLine)</span>
        }
        <span class="muted small" title="@T["Job.Progress.Measured.Title"]">
            @T.Count("Job.Progress.Measured", timeline.Segments.Count, timeline.MeasuredCount)
        </span>
    </div>

    <ToolTimeline Timeline="timeline" Position="position" Measuring="Job.Measuring" Schedule="schedule" SegmentSelected="FocusSegment" />
}
else
{
    <p class="muted small pad">@(Job.Error is { } error ? T[error] : T[PhaseTexts.GetValueOrDefault(Job.Phase, Fetching)])</p>
}

@code {
    private static readonly Text Fetching = Texts.Of("Job.Progress.Phase.Fetching");

    private static readonly IReadOnlyDictionary<JobPhase, Text> PhaseTexts = new Dictionary<JobPhase, Text>
    {
        [JobPhase.Resolving] = Texts.Of("Job.Progress.Phase.Resolving"),
        [JobPhase.Downloading] = Texts.Of("Job.Progress.Phase.Downloading"),
        [JobPhase.NoFileReported] = Texts.Of("Job.Progress.Phase.NoFileReported"),
        [JobPhase.Failed] = Texts.Of("Job.Progress.Phase.Failed"),
    };

    /// <summary>Clicking an operation on the timeline shows its code in the G-code panel.</summary>
    [Parameter, EditorRequired] public GCodeFocus Focus { get; set; } = default!;

    private void FocusSegment(ToolSegment segment) => Focus.Show(segment.StartLine);

    private static string Css(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
