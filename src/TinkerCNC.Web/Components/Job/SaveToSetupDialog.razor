@* Saving the chosen program: as a file of an existing setup (optionally with the options as set now), or as a new setup. *@
@using TinkerCNC.Programs
@inherits JobControlComponent
@inject SetupLibrary Library

@{
    var program = Control.Program!;
    var setups = Library.List(includeDeleted: false).Select(e => e.Setup).ToList();
}
<Dialog Title="Save to a setup" Icon="save" OnClose="OnClose">
    <Tools>
        <div class="seg seg-sm">
            <button class="@(_existing ? "active" : "")" disabled="@(setups.Count == 0)" @onclick="() => _existing = true">Existing setup</button>
            <button class="@(_existing ? "" : "active")" @onclick="() => _existing = false">New setup</button>
        </div>
    </Tools>
    <ChildContent>
        @if (_existing && setups.Count > 0)
        {
            <div class="save-form">
                <label class="field">Setup
                    <select class="input" @bind="_setupId" @bind:after="SetupChosen">
                        @foreach (var setup in setups)
                        {
                            <option value="@setup.Id">@setup.Name</option>
                        }
                    </select>
                </label>
                <div class="field">
                    <span>What is saved</span>
                    <p class="hint muted">@FileText(program.Source.FileName)</p>
                    <label class="check"><input type="checkbox" @bind="_updateOptions" /> Store the options as set here in the setup</label>
                </div>
                <div class="save-form-foot">
                    @if (_error is not null)
                    {
                        <span class="hint err">@_error</span>
                    }
                    <span class="spacer"></span>
                    <button class="btn btn-sm btn-primary" disabled="@Control.IsBusy" @onclick="SaveAsync">Save</button>
                    <button class="btn btn-sm btn-ghost" @onclick="OnClose">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <p class="muted small">A new setup with the options as set here and <span class="mono">@program.Source.FileName</span> as its first file.</p>
            <SetupNameForm Name="@Path.GetFileNameWithoutExtension(program.Source.FileName)" SaveLabel="Create setup" Busy="Control.IsBusy"
                           Save="(name, notes, replace) => Control.SaveAsNewSetup(name, notes, replace)" OnSaved="OnClose" OnCancel="OnClose" />
        }
    </ChildContent>
</Dialog>

@code {
    private bool _existing;
    private long _setupId;
    private bool _updateOptions;
    private string? _error;

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        var first = Library.List(includeDeleted: false).FirstOrDefault()?.Setup;
        _existing = first is not null;
        _setupId = Control.Setup?.Id ?? first?.Id ?? 0;
        SetupChosen();
    }

    /// <summary>Storing the options is the point when saving to the loaded setup; for another one the file alone is the default.</summary>
    private void SetupChosen() => _updateOptions = _setupId == Control.Setup?.Id;

    private string FileText(string fileName) => Control.SetupFile?.SetupId == _setupId
        ? $"{fileName} is one of this setup's files already."
        : $"{fileName} is added to the setup's files.";

    private async Task SaveAsync()
    {
        _error = null;
        try
        {
            Control.SaveToSetup(_setupId, _updateOptions);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return;
        }
        await OnClose.InvokeAsync();
    }
}
