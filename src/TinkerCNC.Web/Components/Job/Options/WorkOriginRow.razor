@* Where X/Y zero is when the program starts. *@
@inherits JobControlComponent

@{ var look = WorkOriginLooks.For(Options.WorkOrigin); }
<OptionRow Title="Work origin" Hint="Where X/Y zero is when the program starts">
    <div class="seg seg-sm seg-wrap">
        @foreach (var (choice, item) in WorkOriginLooks.All)
        {
            var c = choice;
            <button class="@(Options.WorkOrigin == c ? "active" : "")" @onclick="() => Options.WorkOrigin = c">@item.Label</button>
        }
    </div>
    <p class="hint muted">@look.Hint</p>
    @if (look.Offset)
    {
        <div class="opt-line">
            <label class="inline-field">Offset X <input class="input mono" type="number" step="0.1" @bind="Options.OriginOffsetX" /> mm</label>
            <label class="inline-field">Offset Y <input class="input mono" type="number" step="0.1" @bind="Options.OriginOffsetY" /> mm</label>
        </div>
    }
    @if (look.ProbeBlock)
    {
        <div class="opt-line">
            <label class="inline-field">Block height <input class="input mono" type="number" step="0.1" min="0" @bind="Options.XyzProbeHeight" /> mm</label>
            <label class="inline-field">Tool diameter <input class="input mono" type="number" step="0.001" min="0" @bind="Options.XyzProbeToolDiameter" /> mm</label>
        </div>
    }
</OptionRow>
