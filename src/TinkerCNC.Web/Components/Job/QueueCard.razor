@* The machine's job queue: entries that run one after the other with their setup's options, each waiting for the go
   first; starting, stopping and editing it. *@
@using TinkerCNC.Queue
@inherits JobControlComponent

@{
    var look = Looks.First(l => l.Applies(this)).Look;
    var listed = Queue.Listed;
}
<section class="card queue-card">
    <div class="card-head">
        <h2><Icon Name="queue" /> @T["Job.Queue.Title"]</h2>
        <div class="head-tools">
            <span class="chip @look.Chip">@T[look.Label]</span>
            @if (Queue.JobsTotal > 0)
            {
                <span class="muted small">@T.Count("Job.Queue.JobsDone", Queue.JobsTotal, Queue.JobsDone)</span>
            }
            <button class="btn btn-sm btn-ghost" title="@T["Job.Queue.Add.Title"]" @onclick="() => _adding = true">
                <Icon Name="plus" /> @T["Job.Queue.Add"]
            </button>
            @if (Queue.AfterRunningJob)
            {
                <button class="btn btn-sm btn-danger" title="@T["Job.Queue.StopAfter.Title"]" @onclick="() => _runner.RunAsync(Queue.StopAsync)">
                    <Icon Name="stop" /> @T["Job.Queue.Stop"]
                </button>
            }
            else if (Queue.Running)
            {
                @if (_confirm.IsAsking(this))
                {
                    <button class="btn btn-sm btn-danger btn-danger-solid" title="@T["Job.Queue.ConfirmStop.Title"]" @onclick="StopAsync">
                        <Icon Name="stop" /> @T["Job.ConfirmStop"]
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" title="@T["Job.Queue.Stop.Title"]" @onclick="() => _confirm.AskAsync(this)">
                        <Icon Name="stop" /> @T["Job.Queue.Stop"]
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-primary" disabled="@(!Connected || !listed.Any(i => i.Entry.State == QueueEntryState.Pending))"
                        title="@(Playing ? T["Job.Queue.Start.AfterTitle"] : T["Job.Queue.Start.Title"])"
                        @onclick="() => _runner.Run(Queue.Start)">
                    <Icon Name="play" /> @T["Job.Queue.Start"]
                </button>
            }
            @if (!Queue.Running && (listed.Count > 0 || Queue.JobsDone > 0))
            {
                <button class="btn btn-sm btn-icon" title="@T["Job.Queue.Clear.Title"]" @onclick="() => _runner.Run(Queue.Clear)"><Icon Name="x" /></button>
            }
        </div>
    </div>

    @if (Queue.WaitingForGo && Queue.CurrentItem is { } waiting)
    {
        <div class="notice notice-warn queue-gate">
            <Icon Name="play" />
            <span>@T.Html("Job.Queue.Gate", waiting.Label)</span>
            <button class="btn btn-sm btn-primary" disabled="@(!Connected)" @onclick="() => _runner.RunAsync(Queue.ResumeAsync)"><Icon Name="play" /> @T["Common.Resume"]</button>
        </div>
    }
    @if (Queue.AfterRunningJob)
    {
        <p class="muted small">@T["Job.Queue.AfterRunningJob.Hint"]</p>
    }
    @if (Queue.Error is { } stopped)
    {
        <div class="notice notice-err">@T["Job.Queue.Stopped", T[stopped]]</div>
    }
    @if (_runner.Error is { } error)
    {
        <div class="notice notice-err dismissable" @onclick="_runner.Clear">@T[error] <Icon Name="x" /></div>
    }

    @if (listed.Count == 0)
    {
        <p class="muted small">
            @T["Job.Queue.Empty.Hint"]
        </p>
    }
    else
    {
        <ol class="queue-list">
            @foreach (var (item, index) in listed.Select((item, i) => (item, i)))
            {
                <QueueEntryRow Session="Session" Item="item" Index="index" Count="listed.Count" @key="item.Entry.Id" />
            }
        </ol>
    }
</section>

@if (_adding)
{
    <QueueAddDialog Session="Session" OnClose="() => _adding = false" />
}

@code {
    private sealed record Look(string Chip, Text Label);

    private static readonly (Func<QueueCard, bool> Applies, Look Look)[] Looks =
    [
        (c => c.Queue.WaitingForGo, new("chip-warn", Texts.Of("Job.State.WaitingForGo"))),
        (c => c.Queue.AfterRunningJob, new("chip-info", Texts.Of("Job.Queue.AfterRunningJob"))),
        (c => c.Queue.Current is not null, new("chip-info", Texts.Of("Job.State.Running"))),
        (c => c.Queue.Running, new("chip-warn", Texts.Of("Job.State.Starting"))),
        (c => c.Queue.Error is not null, new("chip-err", Texts.Of("Job.Queue.State.Stopped"))),
        (c => c.Queue.Listed.Count > 0, new("chip-ok", Texts.Of("Job.Queue.State.Ready"))),
        (_ => true, new("chip-dim", Texts.Of("Job.Queue.State.Empty"))),
    ];

    private readonly ActionRunner _runner = new();
    private readonly ConfirmClick _confirm = new();
    private bool _adding;

    private async Task StopAsync()
    {
        _confirm.Clear();
        await _runner.RunAsync(Queue.StopAsync);
    }
}
