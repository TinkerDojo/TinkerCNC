@* The machine's job queue: entries that run one after the other with their setup's options, each waiting for the go
   first; starting, stopping and editing it. *@
@using TinkerCNC.Queue
@inherits JobControlComponent

@{
    var look = Looks.First(l => l.Applies(this)).Look;
    var listed = Queue.Listed;
}
<section class="card queue-card">
    <div class="card-head">
        <h2><Icon Name="queue" /> Queue</h2>
        <div class="head-tools">
            <span class="chip @look.Chip">@look.Label</span>
            @if (Queue.JobsTotal > 0)
            {
                <span class="muted small">@Queue.JobsDone of @Queue.JobsTotal jobs done</span>
            }
            <button class="btn btn-sm btn-ghost" title="Queue files of a setup, or files from this computer with a setup's options" @onclick="() => _adding = true">
                <Icon Name="plus" /> Add…
            </button>
            @if (Queue.Running)
            {
                @if (_confirm.IsAsking(this))
                {
                    <button class="btn btn-sm btn-danger btn-danger-solid" title="Nothing further starts and the running job is stopped" @onclick="StopAsync">
                        <Icon Name="stop" /> Confirm stop
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" title="Stop the queue and the running job; asks once more" @onclick="() => _confirm.AskAsync(this)">
                        <Icon Name="stop" /> Stop queue
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-primary" disabled="@(!Connected || !listed.Any(i => i.Entry.State == QueueEntryState.Pending))"
                        title="Run the pending entries one after the other" @onclick="() => _runner.Run(Queue.Start)">
                    <Icon Name="play" /> Start queue
                </button>
            }
            @if (!Queue.Running && (listed.Count > 0 || Queue.JobsDone > 0))
            {
                <button class="btn btn-sm btn-icon" title="Take every entry out and reset the count" @onclick="() => _runner.Run(Queue.Clear)"><Icon Name="x" /></button>
            }
        </div>
    </div>

    @if (Queue.WaitingForGo && Queue.CurrentItem is { } waiting)
    {
        <div class="notice notice-warn queue-gate">
            <Icon Name="play" />
            <span><b>@waiting.Label</b> is on the machine, paused before anything moves. Put the piece in place, then hold the machine's button until it continues, or press Resume.</span>
            <button class="btn btn-sm btn-primary" disabled="@(!Connected)" @onclick="() => _runner.RunAsync(Queue.ResumeAsync)"><Icon Name="play" /> Resume</button>
        </div>
    }
    @if (Queue.Error is { } stopped)
    {
        <div class="notice notice-err">Queue stopped. @stopped</div>
    }
    @if (_runner.Error is { } error)
    {
        <div class="notice notice-err dismissable" @onclick="_runner.Clear">@error <Icon Name="x" /></div>
    }

    @if (listed.Count == 0)
    {
        <p class="muted small">
            Nothing queued. Add files to run them one after the other with a setup's options; every job waits for the go
            before anything moves, so the piece can be swapped in between.
        </p>
    }
    else
    {
        <ol class="queue-list">
            @foreach (var (item, index) in listed.Select((item, i) => (item, i)))
            {
                <QueueEntryRow Session="Session" Item="item" Index="index" Count="listed.Count" @key="item.Entry.Id" />
            }
        </ol>
    }
</section>

@if (_adding)
{
    <QueueAddDialog Session="Session" OnClose="() => _adding = false" />
}

@code {
    private sealed record Look(string Chip, string Label);

    private static readonly (Func<QueueCard, bool> Applies, Look Look)[] Looks =
    [
        (c => c.Queue.WaitingForGo, new("chip-warn", "Waiting for the go")),
        (c => c.Queue.Current is not null, new("chip-info", "Running")),
        (c => c.Queue.Running, new("chip-warn", "Starting…")),
        (c => c.Queue.Error is not null, new("chip-err", "Stopped")),
        (c => c.Queue.Listed.Count > 0, new("chip-ok", "Ready")),
        (_ => true, new("chip-dim", "Empty")),
    ];

    private readonly ActionRunner _runner = new();
    private readonly ConfirmClick _confirm = new();
    private bool _adding;

    private async Task StopAsync()
    {
        _confirm.Clear();
        await _runner.RunAsync(Queue.StopAsync);
    }
}
