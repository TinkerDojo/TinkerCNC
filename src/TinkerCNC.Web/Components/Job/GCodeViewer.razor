@* Window of the program around the line being executed (or a line picked on the timeline). *@

<div class="gcode-lines">
    @for (var line = First; line <= Last; line++)
    {
        var n = line;
        var segment = Analysis.SegmentAt(n);
        <div class="gl @LineClass(n)" style="--tool:@ToolPalette.ColorFor(segment?.ToolNumber)">
            <span class="gl-no">@n</span>
            <span class="gl-tool"></span>
            <span class="gl-text">@Analysis.Lines[n - 1]</span>
            <span class="gl-time">@LineTime(n)</span>
        </div>
    }
</div>

@code {
    private const int LinesBefore = 20;
    private const int LinesAfter = 80;

    [Parameter, EditorRequired] public JobTimeline Timeline { get; set; } = default!;

    private GCodeAnalysis Analysis => Timeline.Analysis;
    [Parameter] public int? CurrentLine { get; set; }
    /// <summary>Line to centre on when not following the machine.</summary>
    [Parameter] public int? FocusLine { get; set; }
    [Parameter] public bool Follow { get; set; } = true;

    private int Centre => Math.Clamp((Follow ? CurrentLine : FocusLine) ?? CurrentLine ?? 1, 1, Math.Max(1, Analysis.LineCount));
    private int First => Math.Max(1, Centre - LinesBefore);
    private int Last => Math.Min(Analysis.LineCount, Centre + LinesAfter);

    // Keyed by the sign of (line - current line): before, at, after.
    private static readonly IReadOnlyDictionary<int, string> RelativeClasses = new Dictionary<int, string>
    {
        [-1] = "done",
        [0] = "current",
        [1] = "",
    };

    private string LineClass(int line) => CurrentLine is { } current ? RelativeClasses[Math.Sign(line - current)] : "";

    private string LineTime(int line) => Timeline.Times.Seconds[line - 1] is var seconds && seconds >= 0.05
        ? seconds.ToString("0.0", CultureInfo.InvariantCulture) + "s"
        : "";
}
