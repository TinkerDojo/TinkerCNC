@* The program chosen to start: what it is, where it comes from, its size, and saving it with its options to a setup. *@
@inherits JobControlComponent

@{ var program = Control.Program!; }
<div class="program-strip">
    <div class="program-id">
        <Icon Name="file" Size="20" />
        <div class="program-text">
            <div class="program-name">
                <span>@(Control.Setup?.Name ?? program.Source.FileName)</span>
                @if (Control.Setup is not null)
                {
                    <span class="mono small muted">@program.Source.FileName</span>
                    @if (Control.SetupFile is null)
                    {
                        <span class="tag" title="@T["Setups.Program.OneOffHint"]">@T["Setups.Program.OneOff"]</span>
                    }
                    @if (Control.SetupChanged)
                    {
                        <span class="tag tag-warn" title="@T["Setups.Program.ChangedHint"]">@T["Setups.Program.Changed"]</span>
                    }
                }
            </div>
            <div class="muted small">@T[program.Source.Describe()]</div>
        </div>
    </div>
    <div class="program-facts">
        @if (program.Bounds is { } b)
        {
            <span class="tag mono" title="@T["Setups.Program.SizeHint"]">@Mm(b.Width) × @Mm(b.Depth) × @Mm(b.MaxZ - b.MinZ) mm</span>
            <span class="tag mono" title="@T["Setups.Program.CornerHint"]">@T["Setups.Program.Corner", Mm(b.MinX), Mm(b.MinY)]</span>
        }
        <span class="tag">@T.Count("Setups.Program.Operations", program.Analysis.Segments.Count)</span>
        @if (Job.Timeline is { } timeline)
        {
            <span class="tag" title="@T["Setups.Program.TimeHint"]"><Icon Name="stopwatch" Size="12" /> @TimeFormat.Duration(timeline.TotalSeconds)</span>
        }
    </div>
    <div class="program-save">
        @if (Control.Setup is not null)
        {
            <button class="btn btn-sm btn-ghost" disabled="@Control.IsBusy" title="@T["Setups.Program.SaveHint"]"
                    @onclick="() => _runner.Run(Control.SaveChanges)">
                <Icon Name="save" /> @T["Common.Save"]
            </button>
        }
        <button class="btn btn-sm btn-ghost" disabled="@Control.IsBusy" title="@T["Setups.Program.SaveToHint"]"
                @onclick="() => _dialog = true">
            <Icon Name="save" /> @T["Setups.Program.SaveTo"]
        </button>
    </div>
</div>
@if (_dialog)
{
    <SaveToSetupDialog Session="Session" OnClose="() => _dialog = false" />
}
@if (_runner.Error is { } error)
{
    <p class="hint err">@T[error]</p>
}

@code {
    private readonly ActionRunner _runner = new();
    private bool _dialog;

    private static string Mm(double value) => StartOptionsText.Mm(value);
}
