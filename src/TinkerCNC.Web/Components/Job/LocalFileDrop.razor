@* A G-code file from this computer: dropped on the zone or picked with the file dialog. *@

<label class="drop-zone @(Busy ? "disabled" : "")">
    <Icon Name="upload" Size="30" />
    <b>@T["Setups.Local.Drop"]</b>
    <span class="muted small">@T["Setups.Local.Hint", ProgramFiles.AcceptText]</span>
    <InputFile OnChange="OnChangeAsync" accept="@ProgramFiles.Accept" disabled="@Busy" />
</label>
@if (_runner.Error is { } error)
{
    <p class="hint err">@T[error]</p>
}

@code {
    private readonly ActionRunner _runner = new();

    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<ChosenFile> OnFile { get; set; }

    private Task OnChangeAsync(InputFileChangeEventArgs e) =>
        _runner.RunAsync(async () => await OnFile.InvokeAsync(await ProgramFiles.ReadAsync(e.File)));
}
