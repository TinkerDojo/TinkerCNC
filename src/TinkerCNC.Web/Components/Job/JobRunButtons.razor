@* Pause, resume and stop the running program. Stopping takes a second click to confirm. *@
@inherits JobControlComponent

@if (Control.CanResume)
{
    <button class="btn btn-primary" disabled="@(!Connected)" title="@T["Job.Run.Resume.Title"]"
            @onclick="() => _runner.RunAsync(Control.ResumeAsync)">
        <Icon Name="play" /> @T["Common.Resume"]
    </button>
}
else
{
    <button class="btn" disabled="@(!Connected || !Control.CanPause)" title="@T["Job.Run.Pause.Title"]"
            @onclick="() => _runner.RunAsync(Control.PauseAsync)">
        <Icon Name="pause" /> @T["Common.Pause"]
    </button>
}
@if (_confirm.IsAsking(this))
{
    <button class="btn btn-danger btn-danger-solid" disabled="@(!Connected || !Control.CanStop)" title="@T["Job.Run.ConfirmStop.Title"]"
            @onclick="StopAsync">
        <Icon Name="stop" /> @T["Job.ConfirmStop"]
    </button>
}
else
{
    <button class="btn btn-danger" disabled="@(!Connected || !Control.CanStop)" title="@T["Job.Run.Stop.Title"]"
            @onclick="() => _confirm.AskAsync(this)">
        <Icon Name="stop" /> @T["Common.Stop"]
    </button>
}
@if (_runner.Error is { } error)
{
    <span class="chip chip-err" title="@T[error]">@T[error]</span>
}

@code {
    private readonly ActionRunner _runner = new();
    private readonly ConfirmClick _confirm = new();

    private async Task StopAsync()
    {
        _confirm.Clear();
        await _runner.RunAsync(Control.StopAsync);
    }
}
