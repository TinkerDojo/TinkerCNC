<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TinkerCNC.Core\TinkerCNC.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tinkercnc-cli</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- dotnet tool: dotnet tool install -g TinkerCNC.Cli, then "tinkercnc-cli discover" -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tinkercnc-cli</ToolCommandName>
    <RollForward>Major</RollForward>
    <PackageId>TinkerCNC.Cli</PackageId>
    <Title>TinkerCNC CLI</Title>
    <Description>Command-line tool for the Makera Z1 / Z1 Pro desktop CNC: discover machines on the network, query one by address, and open an interactive console over Wi-Fi/LAN or USB serial.</Description>
    <PackageTags>cnc;gcode;makera;makera-z1;z1;cnc-controller;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\build\icons\TinkerCNC.png" Pack="true" PackagePath="\icon.png" Visible="false" />
  </ItemGroup>

</Project>
