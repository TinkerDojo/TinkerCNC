<Project Sdk="Microsoft.NET.Sdk">

  <!-- Machine services shared by every front end (Blazor UI, endpoints, later MQTT/API): sessions, discovery,
       job tracking, camera and time-lapse feeds, notifications. No UI and no HTTP in here. -->

  <ItemGroup>
    <ProjectReference Include="..\TinkerCNC.Core\TinkerCNC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <!-- Decodes camera frames for MP4 recordings (the encoder itself is managed code in TinkerCNC.Core). -->
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
  </ItemGroup>

  <!-- The texts, one file per language (see TextCatalog); embedded as <Assembly>.Localization.<code>.json. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
